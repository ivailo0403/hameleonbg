{%- comment -%}
  Хамелеон: home hero.
  Left: badge, big headline, text, buttons and a trust row.
  Right: a "wall" that cycles through real Vitex colours, a fanned colour deck and a floating
  "ready for pickup" card. Each "family" block is one colour-family link under the hero.
{%- endcomment -%}
{%- style -%}
  .hm-hero {
    position: relative;
    overflow: hidden;
    padding: 4rem 0 4.8rem;
    background:
      radial-gradient(60rem 40rem at 90% 10%, rgba(0, 170, 193, 0.12), transparent 60%),
      radial-gradient(50rem 40rem at 0% 100%, rgba(25, 165, 74, 0.12), transparent 60%),
      #ffffff;
  }

  .hm-hero__inner {
    display: grid;
    gap: 4.8rem;
    align-items: center;
  }

  .hm-hero__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2rem;
  }

  .hm-hero__title {
    margin: 0;
    font-family: var(--hm-font-display);
    font-size: clamp(3.4rem, 4.8vw, 5.6rem);
    font-weight: 800;
    line-height: 1.04;
    letter-spacing: -0.03em;
    color: var(--hm-text-strong);
  }

  .hm-hero__text {
    margin: 0;
    max-width: 52rem;
    font-size: 1.8rem;
    line-height: 1.6;
    color: var(--hm-text-muted);
  }

  .hm-hero__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
  }

  .hm-hero__buttons .hm-btn {
    min-height: 5.6rem;
    padding: 0 2.8rem;
    font-size: 1.6rem;
  }

  .hm-hero__trust {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.4rem;
    margin: 0.4rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--hm-text-strong);
  }

  .hm-hero__trust li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .hm-hero__trust svg {
    width: 2rem;
    height: 2rem;
    color: var(--hm-brand-green);
  }

  /* Visual */
  .hm-hero__visual {
    position: relative;
    min-height: 40rem;
  }

  .hm-wall {
    position: absolute;
    inset: 0 0 4rem 3rem;
    border-radius: 2.4rem;
    background: var(--hm-wall, #0095ab);
    box-shadow: var(--hm-shadow-lg);
    transition: background-color 1.2s var(--hm-ease);
    overflow: hidden;
  }

  .hm-wall::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.18), transparent 40%),
      linear-gradient(0deg, rgba(0, 0, 0, 0.12), transparent 30%);
  }

  .hm-wall__floor {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 18%;
    background: linear-gradient(180deg, #d9c4a5, #c4ab88);
  }

  .hm-wall__label {
    position: absolute;
    top: 2rem;
    left: 2rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.8rem 1.4rem 0.8rem 0.8rem;
    border-radius: var(--hm-radius-pill);
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(6px);
    box-shadow: var(--hm-shadow-sm);
    font-family: var(--hm-font-display);
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--hm-text-strong);
  }

  .hm-wall__chip {
    width: 2.8rem;
    height: 2.8rem;
    border-radius: 50%;
    background: var(--hm-wall, #0095ab);
    transition: background-color 1.2s var(--hm-ease);
    box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.8);
  }

  .hm-wall__code {
    color: var(--hm-text-muted);
    font-weight: 600;
  }

  .hm-deck {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 22rem;
    height: 16rem;
  }

  .hm-deck__card {
    position: absolute;
    left: 2rem;
    bottom: 1rem;
    width: 7.2rem;
    height: 14rem;
    border-radius: 1.2rem;
    border: 4px solid #ffffff;
    box-shadow: var(--hm-shadow-md);
    transform-origin: 50% 100%;
    transform: rotate(calc(var(--i) * 11deg - 22deg));
    transition: transform 0.6s var(--hm-ease);
  }

  .hm-hero__visual:hover .hm-deck__card {
    transform: rotate(calc(var(--i) * 15deg - 30deg));
  }

  .hm-ready {
    position: absolute;
    right: -0.8rem;
    bottom: 1.2rem;
    display: flex;
    align-items: center;
    gap: 1.2rem;
    max-width: 26rem;
    padding: 1.2rem 1.6rem;
    border-radius: 1.6rem;
    background: #ffffff;
    box-shadow: var(--hm-shadow-lg);
    animation: hm-float 5s ease-in-out infinite;
  }

  .hm-ready__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 4rem;
    height: 4rem;
    border-radius: 50%;
    background: var(--hm-in-stock-bg);
    color: var(--hm-in-stock);
  }

  .hm-ready__icon svg {
    width: 2.2rem;
    height: 2.2rem;
  }

  .hm-ready strong {
    display: block;
    font-family: var(--hm-font-display);
    font-size: 1.4rem;
    color: var(--hm-text-strong);
  }

  .hm-ready span {
    font-size: 1.3rem;
    color: var(--hm-text-muted);
  }

  /* Colour families */
  .hm-families {
    display: flex;
    gap: 1rem;
    margin: 4rem 0 0;
    padding: 0 0 0.4rem;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .hm-families::-webkit-scrollbar {
    display: none;
  }

  .hm-family {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.6rem 1.4rem 0.6rem 0.6rem;
    border: 1px solid var(--hm-border);
    border-radius: var(--hm-radius-pill);
    background: #ffffff;
    color: var(--hm-text-strong);
    font-family: var(--hm-font-display);
    font-size: 1.4rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition: transform 0.25s var(--hm-ease), box-shadow 0.25s var(--hm-ease), border-color 0.25s;
  }

  .hm-family:hover {
    transform: translateY(-2px);
    border-color: transparent;
    box-shadow: var(--hm-shadow-md);
  }

  .hm-family__dot {
    width: 2.8rem;
    height: 2.8rem;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.08);
  }

  @media screen and (min-width: 750px) {
    .hm-hero {
      padding: 7.2rem 0 6.4rem;
    }

    .hm-hero__visual {
      min-height: 52rem;
    }

    .hm-deck {
      width: 26rem;
      height: 20rem;
    }

    .hm-deck__card {
      width: 8.8rem;
      height: 17rem;
    }

    .hm-families {
      flex-wrap: wrap;
      overflow: visible;
    }
  }

  @media screen and (min-width: 990px) {
    .hm-hero__inner {
      grid-template-columns: 1.05fr 1fr;
      gap: 6.4rem;
    }
  }
{%- endstyle -%}

{%- assign colors = section.settings.wall_colors | newline_to_br | split: '<br />' -%}

<section class="hm-section hm-hero">
  <div class="page-width">
    <div class="hm-hero__inner">
      <div class="hm-hero__copy">
        {%- if section.settings.eyebrow != blank -%}
          <span class="hm-pill" data-reveal><span class="hm-pill__dot" aria-hidden="true"></span>{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        <h1 class="hm-hero__title" data-reveal style="--d: 1">
          {{- section.settings.heading | escape -}}
          {%- if section.settings.heading_highlight != blank %} <span class="hm-gradient-text">{{ section.settings.heading_highlight | escape }}</span>{% endif -%}
        </h1>
        {%- if section.settings.text != blank -%}
          <p class="hm-hero__text" data-reveal style="--d: 2">{{ section.settings.text | escape }}</p>
        {%- endif -%}
        <div class="hm-hero__buttons" data-reveal style="--d: 3">
          {%- if section.settings.button_label_1 != blank -%}
            <a class="hm-btn hm-btn--primary" href="{{ section.settings.button_link_1 | default: '#cvetove' }}">
              {{- section.settings.button_label_1 | escape }} <span class="hm-btn__arrow" aria-hidden="true">→</span>
            </a>
          {%- endif -%}
          {%- if section.settings.button_label_2 != blank -%}
            <a class="hm-btn hm-btn--secondary" href="{{ section.settings.button_link_2 | default: '#kalkulator' }}">
              {{- section.settings.button_label_2 | escape -}}
            </a>
          {%- endif -%}
        </div>
        <ul class="hm-hero__trust" data-reveal style="--d: 4">
          {%- for i in (1..3) -%}
            {%- liquid
              assign key = 'trust_' | append: i
              assign item = section.settings[key]
            -%}
            {%- if item != blank -%}
              <li>{%- render 'hameleon-icon', icon: 'check' -%}{{ item | escape }}</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>

      <div class="hm-hero__visual" data-reveal="scale" style="--d: 2" aria-hidden="true">
        <div class="hm-wall" data-hm-wall>
          <span class="hm-wall__floor"></span>
          <div class="hm-wall__label">
            <span class="hm-wall__chip"></span>
            <span><span data-hm-wall-name>Blue Bliss</span> <span class="hm-wall__code" data-hm-wall-hex>#0095AB</span></span>
          </div>
        </div>
        <div class="hm-deck">
          {%- for c in colors limit: 5 -%}
            {%- assign parts = c | strip | split: '|' -%}
            <span class="hm-deck__card" style="--i: {{ forloop.index0 }}; background: {{ parts[1] | strip }};"></span>
          {%- endfor -%}
        </div>
        {%- if section.settings.ready_title != blank -%}
          <div class="hm-ready">
            <span class="hm-ready__icon">{%- render 'hameleon-icon', icon: 'check' -%}</span>
            <span><strong>{{ section.settings.ready_title | escape }}</strong><span>{{ section.settings.ready_text | escape }}</span></span>
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- if section.blocks.size > 0 -%}
      <nav id="cvetove" aria-label="{{ section.settings.families_label | escape }}">
        <ul class="hm-families">
          {%- for block in section.blocks -%}
            <li data-reveal style="--d: {{ forloop.index0 | at_most: 8 }}" {{ block.shopify_attributes }}>
              <a class="hm-family" href="{% if block.settings.link != blank %}{{ block.settings.link }}{% else %}{{ routes.search_url }}?type=product&amp;q={{ block.settings.name | url_encode }}{% endif %}">
                <span class="hm-family__dot" style="background: {{ block.settings.color }};" aria-hidden="true"></span>
                {{- block.settings.name | escape -}}
              </a>
            </li>
          {%- endfor -%}
          {%- if section.settings.card_link_label != blank -%}
            <li data-reveal style="--d: 9">
              <a class="hm-family" href="{{ section.settings.card_link | default: routes.all_products_collection_url }}" style="background: var(--hm-text-strong); color: #fff; border-color: transparent;">
                {{- section.settings.card_link_label | escape }} →
              </a>
            </li>
          {%- endif -%}
        </ul>
      </nav>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    var wall = document.currentScript.previousElementSibling.querySelector('[data-hm-wall]');
    if (!wall) return;
    var colors = {{ colors | json }}
      .map(function (c) { var p = c.trim().split('|'); return p.length === 2 ? { name: p[0].trim(), hex: p[1].trim() } : null; })
      .filter(Boolean);
    if (!colors.length) return;
    var host = wall.closest('.hm-hero__visual');
    var nameEl = wall.querySelector('[data-hm-wall-name]');
    var hexEl = wall.querySelector('[data-hm-wall-hex]');
    var i = 0;
    function show() {
      var c = colors[i % colors.length];
      host.style.setProperty('--hm-wall', c.hex);
      nameEl.textContent = c.name;
      hexEl.textContent = c.hex;
      i++;
    }
    show();
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) setInterval(show, 2600);
  })();
</script>

{% schema %}
{
  "name": "Хамелеон: hero",
  "tag": "div",
  "class": "section",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Badge", "default": "Тониране на място · Велико Търново" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Изберете цвят онлайн. Вземете го" },
    { "type": "text", "id": "heading_highlight", "label": "Heading, highlighted end", "default": "тониран от магазина." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "1320 цвята Vitex, точното количество боя и съвет от хора, които го правят от години." },
    { "type": "text", "id": "button_label_1", "label": "Primary button label", "default": "Изберете цвят" },
    { "type": "url", "id": "button_link_1", "label": "Primary button link" },
    { "type": "text", "id": "button_label_2", "label": "Secondary button label", "default": "Колко боя ми трябва?" },
    { "type": "url", "id": "button_link_2", "label": "Secondary button link" },
    { "type": "text", "id": "trust_1", "label": "Trust point 1", "default": "Готово до 3 работни дни" },
    { "type": "text", "id": "trust_2", "label": "Trust point 2", "default": "Плащане в магазина" },
    { "type": "text", "id": "trust_3", "label": "Trust point 3", "default": "Без предплащане" },
    { "type": "textarea", "id": "wall_colors", "label": "Wall colours (one per line: Name|#HEX)", "default": "Blue Bliss|#0095AB\nAquadazzle|#217553\nZambia|#FE9A28\nPurple Hollyhock|#D771AF\nHappy Face|#FED426\nCherished One|#F89495\nJob's Tears|#00627E\nGlass Bottle|#96BC5E" },
    { "type": "text", "id": "ready_title", "label": "Floating card title", "default": "Поръчката е готова" },
    { "type": "text", "id": "ready_text", "label": "Floating card text", "default": "Тонирана и чака Ви на щанда" },
    { "type": "text", "id": "families_label", "label": "Colour families label (for screen readers)", "default": "Цветови групи" },
    { "type": "text", "id": "card_link_label", "label": "Last pill: all colours", "default": "Всички 1320 цвята" },
    { "type": "url", "id": "card_link", "label": "Last pill: link" }
  ],
  "blocks": [
    {
      "type": "family",
      "name": "Colour family",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Бели" },
        { "type": "color", "id": "color", "label": "Swatch colour", "default": "#E4E2D9" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Хамелеон: hero",
      "blocks": [
        { "type": "family", "settings": { "name": "Бели", "color": "#E4E2D9" } },
        { "type": "family", "settings": { "name": "Бежови", "color": "#BCA180" } },
        { "type": "family", "settings": { "name": "Жълти", "color": "#FED426" } },
        { "type": "family", "settings": { "name": "Оранжеви", "color": "#FE9A28" } },
        { "type": "family", "settings": { "name": "Червени", "color": "#F89495" } },
        { "type": "family", "settings": { "name": "Виолетови", "color": "#D771AF" } },
        { "type": "family", "settings": { "name": "Сини", "color": "#0095AB" } },
        { "type": "family", "settings": { "name": "Зелени", "color": "#217553" } },
        { "type": "family", "settings": { "name": "Кафяви", "color": "#AD8D6D" } },
        { "type": "family", "settings": { "name": "Сиви", "color": "#B7B8BC" } }
      ]
    }
  ]
}
{% endschema %}
