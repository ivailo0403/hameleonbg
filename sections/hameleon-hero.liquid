{%- comment -%}
  Хамелеон: home hero.
  Left: badge, big headline, text, buttons and a trust row.
  Right: a room whose wall takes the colour the visitor picks, either from the colour strip under
  the hero (family tabs, then shades) or from the fan deck in the room's bottom left corner, which
  opens a small catalogue with every Vitex colour. Until someone picks, the wall cycles through
  the "wall colours". Each "family" block is one family tab. Logic: assets/hameleon-hero.js.
{%- endcomment -%}
{%- style -%}
  .hm-hero {
    display: block;
    position: relative;
    overflow: hidden;
    padding: 4rem 0 4.8rem;
    background:
      radial-gradient(60rem 40rem at 90% 10%, rgba(0, 170, 193, 0.12), transparent 60%),
      radial-gradient(50rem 40rem at 0% 100%, rgba(25, 165, 74, 0.12), transparent 60%),
      #ffffff;
  }

  .hm-hero__inner {
    display: grid;
    gap: 4.8rem;
    align-items: center;
  }

  .hm-hero__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2rem;
  }

  .hm-hero__title {
    margin: 0;
    font-family: var(--hm-font-display);
    font-size: clamp(3.4rem, 4.8vw, 5.6rem);
    font-weight: 800;
    line-height: 1.04;
    letter-spacing: -0.03em;
    color: var(--hm-text-strong);
  }

  .hm-hero__text {
    margin: 0;
    max-width: 52rem;
    font-size: 1.8rem;
    line-height: 1.6;
    color: var(--hm-text-muted);
  }

  .hm-hero__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
  }

  .hm-hero__buttons .hm-btn {
    min-height: 5.6rem;
    padding: 0 2.8rem;
    font-size: 1.6rem;
  }

  .hm-hero__trust {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.4rem;
    margin: 0.4rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--hm-text-strong);
  }

  .hm-hero__trust li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .hm-hero__trust svg {
    width: 2rem;
    height: 2rem;
    color: var(--hm-brand-green);
  }

  /* Visual */
  .hm-hero__visual {
    position: relative;
    min-height: 36rem;
  }

  .hm-wall {
    position: absolute;
    inset: 0 0 3.2rem 0;
    border-radius: 2.4rem;
    box-shadow: var(--hm-shadow-lg);
    overflow: hidden;
    background: var(--wall, #e8e2d6);
  }

  .hm-wall .hm-room {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hm-wall__label {
    position: absolute;
    top: 1.6rem;
    left: 1.6rem;
    right: 1.6rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    width: fit-content;
    max-width: calc(100% - 3.2rem);
    padding: 0.6rem 0.6rem 0.6rem 0.6rem;
    border-radius: var(--hm-radius-pill);
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(6px);
    box-shadow: var(--hm-shadow-md);
    font-family: var(--hm-font-display);
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--hm-text-strong);
  }

  .hm-wall__chip {
    flex: 0 0 3.2rem;
    width: 3.2rem;
    height: 3.2rem;
    border-radius: 50%;
    background: var(--wall, #0095ab);
    transition: background-color 0.7s var(--hm-ease);
    box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.9), 0 0 0 1px rgba(0, 0, 0, 0.06);
  }

  .hm-wall__name {
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .hm-wall__code {
    color: var(--hm-text-muted);
    font-weight: 600;
  }

  .hm-wall__order {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.7rem 1.2rem;
    border-radius: var(--hm-radius-pill);
    background: var(--hm-primary);
    color: #ffffff;
    text-decoration: none;
    transition: background-color 0.2s;
  }

  .hm-wall__order:hover {
    background: var(--hm-primary-hover);
  }

  /* Fan deck: opens the mini catalogue */
  .hm-deck {
    position: absolute;
    left: 1.2rem;
    bottom: 0;
    z-index: 3;
    width: 15rem;
    height: 15rem;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .hm-deck__card {
    position: absolute;
    left: 3rem;
    bottom: 1.6rem;
    width: 5.6rem;
    height: 11rem;
    border-radius: 1rem;
    border: 3px solid #ffffff;
    box-shadow: var(--hm-shadow-md);
    transform-origin: 50% 100%;
    transform: rotate(calc(var(--i) * 10deg - 20deg));
    transition: transform 0.5s var(--hm-ease);
  }

  .hm-deck:hover .hm-deck__card,
  .hm-deck[aria-expanded='true'] .hm-deck__card {
    transform: rotate(calc(var(--i) * 16deg - 32deg));
  }

  .hm-deck__tag {
    position: absolute;
    left: 0;
    bottom: 0;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem 1.2rem;
    border-radius: var(--hm-radius-pill);
    background: var(--hm-text-strong);
    color: #ffffff;
    font-family: var(--hm-font-display);
    font-size: 1.3rem;
    font-weight: 700;
    white-space: nowrap;
    box-shadow: var(--hm-shadow-md);
  }

  .hm-deck__tag svg {
    width: 1.8rem;
    height: 1.8rem;
  }

  .hm-deck:focus-visible {
    outline: 3px solid var(--hm-link);
    outline-offset: 4px;
    border-radius: 1.2rem;
  }

  /* Mini catalogue */
  .hm-mini {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 5.2rem;
    z-index: 4;
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    max-height: calc(100% - 5.2rem);
    padding: 1.6rem;
    box-sizing: border-box;
    border-radius: 2rem;
    background: #ffffff;
    box-shadow: var(--hm-shadow-lg);
    transform-origin: 0 100%;
    animation: hm-mini-in 0.35s var(--hm-ease);
  }

  .hm-mini[hidden] {
    display: none;
  }

  @keyframes hm-mini-in {
    from {
      opacity: 0;
      transform: translateY(1.2rem) scale(0.96);
    }
  }

  .hm-mini__top {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .hm-mini__title {
    margin: 0;
    flex: 1;
    font-family: var(--hm-font-display);
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--hm-text-strong);
  }

  .hm-mini__search {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: 14rem;
    height: 3.8rem;
    padding: 0 1rem;
    box-sizing: border-box;
    border: 1px solid var(--hm-border-strong);
    border-radius: var(--hm-radius-pill);
    color: var(--hm-text-muted);
  }

  .hm-mini__search svg {
    flex: 0 0 1.6rem;
    width: 1.6rem;
    height: 1.6rem;
  }

  .hm-mini__search input {
    width: 100%;
    min-width: 0;
    border: 0;
    outline: none;
    background: none;
    font-size: 1.4rem;
  }

  .hm-mini__close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.8rem;
    height: 3.8rem;
    border: 0;
    border-radius: 50%;
    background: var(--hm-surface-sunken);
    font-size: 2rem;
    line-height: 1;
    cursor: pointer;
  }

  .hm-mini__tabs {
    display: flex;
    gap: 0.6rem;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .hm-mini__tabs::-webkit-scrollbar {
    display: none;
  }

  .hm-mini__tab {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 1.1rem 0.5rem 0.5rem;
    border: 1px solid var(--hm-border);
    border-radius: var(--hm-radius-pill);
    background: #ffffff;
    font-family: var(--hm-font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--hm-text-strong);
    cursor: pointer;
  }

  .hm-mini__tab[aria-pressed='true'] {
    border-color: var(--hm-text-strong);
    background: var(--hm-text-strong);
    color: #ffffff;
  }

  .hm-mini__tab i {
    width: 1.8rem;
    height: 1.8rem;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.1);
  }

  .hm-mini__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(3.6rem, 1fr));
    gap: 0.6rem;
    min-height: 0;
    overflow-y: auto;
    padding: 0.2rem;
  }

  /* Swatch button (mini catalogue and the strip under the hero) */
  .hm-swatch {
    position: relative;
    aspect-ratio: 1;
    padding: 0;
    border: 0;
    border-radius: 0.9rem;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.08);
    cursor: pointer;
    transition: transform 0.2s var(--hm-ease), box-shadow 0.2s;
  }

  .hm-swatch:hover {
    transform: scale(1.12);
    z-index: 1;
    box-shadow: var(--hm-shadow-md);
  }

  .hm-swatch[aria-pressed='true'] {
    box-shadow: 0 0 0 2px #ffffff, 0 0 0 4px var(--hm-text-strong);
  }

  .hm-ready {
    position: absolute;
    right: -0.8rem;
    bottom: 0;
    display: flex;
    align-items: center;
    gap: 1.2rem;
    max-width: 26rem;
    padding: 1.2rem 1.6rem;
    border-radius: 1.6rem;
    background: #ffffff;
    box-shadow: var(--hm-shadow-lg);
    animation: hm-float 5s ease-in-out infinite;
  }

  .hm-ready__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 4rem;
    height: 4rem;
    border-radius: 50%;
    background: var(--hm-in-stock-bg);
    color: var(--hm-in-stock);
  }

  .hm-ready__icon svg {
    width: 2.2rem;
    height: 2.2rem;
  }

  .hm-ready strong {
    display: block;
    font-family: var(--hm-font-display);
    font-size: 1.4rem;
    color: var(--hm-text-strong);
  }

  .hm-ready span {
    font-size: 1.3rem;
    color: var(--hm-text-muted);
  }

  /* Colour picker under the hero */
  .hm-picker {
    margin-top: 4rem;
    padding: 2rem;
    border: 1px solid var(--hm-border);
    border-radius: 2.4rem;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(8px);
    box-shadow: var(--hm-shadow-md);
  }

  .hm-picker__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.4rem;
  }

  .hm-picker__title {
    margin: 0;
    font-family: var(--hm-font-display);
    font-size: 1.7rem;
    font-weight: 800;
    color: var(--hm-text-strong);
  }

  .hm-picker__title span {
    font-family: var(--hm-font-body);
    font-size: 1.4rem;
    font-weight: 500;
    color: var(--hm-text-muted);
  }

  .hm-families {
    display: flex;
    gap: 0.8rem;
    margin: 0;
    padding: 0 0 0.4rem;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .hm-families::-webkit-scrollbar {
    display: none;
  }

  .hm-family {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.5rem 1.4rem 0.5rem 0.5rem;
    border: 1px solid var(--hm-border);
    border-radius: var(--hm-radius-pill);
    background: #ffffff;
    color: var(--hm-text-strong);
    font-family: var(--hm-font-display);
    font-size: 1.4rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition: transform 0.25s var(--hm-ease), box-shadow 0.25s var(--hm-ease), border-color 0.25s, background-color 0.25s;
  }

  .hm-family:hover {
    transform: translateY(-2px);
    box-shadow: var(--hm-shadow-sm);
  }

  .hm-family[aria-pressed='true'] {
    border-color: var(--hm-text-strong);
    background: var(--hm-text-strong);
    color: #ffffff;
  }

  .hm-family__dot {
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.08), 0 0 0 2px #ffffff;
  }

  .hm-family--all {
    background: var(--hm-gradient-deep);
    border-color: transparent;
    color: #ffffff;
    padding-left: 1.6rem;
  }

  .hm-shades {
    position: relative;
    margin-top: 1.4rem;
  }

  .hm-shades__row {
    display: flex;
    gap: 0.6rem;
    padding: 0.6rem 0.4rem;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: thin;
  }

  .hm-shades__row .hm-swatch {
    flex: 0 0 4.4rem;
    height: 4.4rem;
    border-radius: 1.2rem;
  }

  .hm-shades::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 4rem;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.95));
    pointer-events: none;
  }

  @media screen and (min-width: 750px) {
    .hm-hero {
      padding: 7.2rem 0 6.4rem;
    }

    .hm-hero__visual {
      min-height: 50rem;
    }

    .hm-wall {
      inset: 0 0 3.2rem 3.2rem;
    }

    .hm-deck {
      left: 0;
      width: 18rem;
      height: 18rem;
    }

    .hm-deck__card {
      width: 6.8rem;
      height: 13.6rem;
    }

    .hm-mini {
      left: 3.2rem;
      right: 1.6rem;
    }

    .hm-picker {
      padding: 2.4rem 2.8rem;
    }
  }

  @media screen and (max-width: 749px) {
    .hm-ready {
      display: none;
    }

    .hm-wall__label .hm-wall__code {
      display: none;
    }
  }

  @media screen and (min-width: 990px) {
    .hm-hero__inner {
      grid-template-columns: 1fr 1.05fr;
      gap: 5.6rem;
    }
  }
{%- endstyle -%}

{%- liquid
  assign colors = section.settings.wall_colors | newline_to_br | split: '<br />'
  assign catalogue_url = settings.hm_catalogue_page | default: '/pages/katalog-tsvetove'
-%}
<script src="{{ 'hameleon-colors.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'hameleon-hero.js' | asset_url }}" defer="defer"></script>

<hameleon-hero class="hm-section hm-hero" data-catalogue-url="{{ catalogue_url }}" data-wall-colors="{{ colors | json | escape }}">
  <div class="page-width">
    <div class="hm-hero__inner">
      <div class="hm-hero__copy">
        {%- if section.settings.eyebrow != blank -%}
          <span class="hm-pill" data-reveal><span class="hm-pill__dot" aria-hidden="true"></span>{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        <h1 class="hm-hero__title" data-reveal style="--d: 1">
          {{- section.settings.heading | escape -}}
          {%- if section.settings.heading_highlight != blank %} <span class="hm-gradient-text">{{ section.settings.heading_highlight | escape }}</span>{% endif -%}
        </h1>
        {%- if section.settings.text != blank -%}
          <p class="hm-hero__text" data-reveal style="--d: 2">{{ section.settings.text | escape }}</p>
        {%- endif -%}
        <div class="hm-hero__buttons" data-reveal style="--d: 3">
          {%- if section.settings.button_label_1 != blank -%}
            <a class="hm-btn hm-btn--primary" href="{{ section.settings.button_link_1 | default: catalogue_url }}">
              {{- section.settings.button_label_1 | escape }} <span class="hm-btn__arrow" aria-hidden="true">→</span>
            </a>
          {%- endif -%}
          {%- if section.settings.button_label_2 != blank -%}
            <a class="hm-btn hm-btn--secondary" href="{{ section.settings.button_link_2 | default: '#kalkulator' }}">
              {{- section.settings.button_label_2 | escape -}}
            </a>
          {%- endif -%}
        </div>
        <ul class="hm-hero__trust" data-reveal style="--d: 4">
          {%- for i in (1..3) -%}
            {%- liquid
              assign key = 'trust_' | append: i
              assign item = section.settings[key]
            -%}
            {%- if item != blank -%}
              <li>{%- render 'hameleon-icon', icon: 'check' -%}{{ item | escape }}</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>

      <div class="hm-hero__visual" data-reveal="scale" style="--d: 2">
        <div class="hm-wall" data-hm-wall>
          {%- render 'hameleon-room', id: 'hm-hero-room' -%}
          <div class="hm-wall__label">
            <span class="hm-wall__chip" aria-hidden="true"></span>
            <span class="hm-wall__name" aria-live="polite"><span data-hm-wall-name>Blue Bliss</span> <span class="hm-wall__code" data-hm-wall-code></span></span>
            <a class="hm-wall__order" href="{{ catalogue_url }}" data-hm-wall-order>Поръчайте <span aria-hidden="true">→</span></a>
          </div>
        </div>
        <button type="button" class="hm-deck" aria-expanded="false" aria-controls="HmMini-{{ section.id }}" data-hm-deck>
          {%- for c in colors limit: 5 -%}
            {%- assign parts = c | strip | split: '|' -%}
            <span class="hm-deck__card" style="--i: {{ forloop.index0 }}; background: {{ parts[1] | strip }};" aria-hidden="true"></span>
          {%- endfor -%}
          <span class="hm-deck__tag">{%- render 'hameleon-icon', icon: 'swatch' -%}Каталог</span>
        </button>
        <div class="hm-mini" id="HmMini-{{ section.id }}" role="dialog" aria-label="Каталог с цветове" hidden data-hm-mini>
          <div class="hm-mini__top">
            <p class="hm-mini__title">1320 цвята Vitex</p>
            <label class="hm-mini__search">
              {%- render 'hameleon-icon', icon: 'search' -%}
              <input type="search" inputmode="search" placeholder="Код или име" aria-label="Търсене по код или име" data-hm-mini-search>
            </label>
            <button type="button" class="hm-mini__close" aria-label="Затворете" data-hm-mini-close>×</button>
          </div>
          <div class="hm-mini__tabs" data-hm-mini-tabs></div>
          <div class="hm-mini__grid" data-hm-mini-grid></div>
        </div>
        {%- if section.settings.ready_title != blank -%}
          <div class="hm-ready" aria-hidden="true">
            <span class="hm-ready__icon">{%- render 'hameleon-icon', icon: 'check' -%}</span>
            <span><strong>{{ section.settings.ready_title | escape }}</strong><span>{{ section.settings.ready_text | escape }}</span></span>
          </div>
        {%- endif -%}
      </div>
    </div>

    <div class="hm-picker" id="cvetove" data-reveal style="--d: 3">
      <div class="hm-picker__head">
        <p class="hm-picker__title">{{ section.settings.picker_title | escape }} <span>{{ section.settings.picker_hint | escape }}</span></p>
      </div>
      <ul class="hm-families" aria-label="{{ section.settings.families_label | escape }}">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            <button type="button" class="hm-family" aria-pressed="false" data-hm-family="{{ block.settings.family }}">
              <span class="hm-family__dot" style="background: {{ block.settings.color }};" aria-hidden="true"></span>
              {{- block.settings.name | escape -}}
            </button>
          </li>
        {%- endfor -%}
        {%- if section.settings.card_link_label != blank -%}
          <li>
            <a class="hm-family hm-family--all" href="{{ section.settings.card_link | default: catalogue_url }}">
              {{- section.settings.card_link_label | escape }} →
            </a>
          </li>
        {%- endif -%}
      </ul>
      <div class="hm-shades">
        <div class="hm-shades__row" data-hm-shades></div>
      </div>
    </div>
  </div>
</hameleon-hero>

{% schema %}
{
  "name": "Хамелеон: hero",
  "tag": "div",
  "class": "section",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Badge", "default": "Боя онлайн · тониране във Велико Търново" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Изберете цвят. Поръчайте онлайн." },
    { "type": "text", "id": "heading_highlight", "label": "Heading, highlighted end", "default": "Ние я тонираме." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "1320 цвята Vitex и 78 мазилки Motivo. Вижте цвета на стената, изчислете колко литра Ви трябват и поръчайте с няколко клика." },
    { "type": "text", "id": "button_label_1", "label": "Primary button label", "default": "Отворете каталога" },
    { "type": "url", "id": "button_link_1", "label": "Primary button link (defaults to the paint catalogue)" },
    { "type": "text", "id": "button_label_2", "label": "Secondary button label", "default": "Колко боя ми трябва?" },
    { "type": "url", "id": "button_link_2", "label": "Secondary button link" },
    { "type": "text", "id": "trust_1", "label": "Trust point 1", "default": "Поръчка онлайн 24/7" },
