{%- comment -%}
  Хамелеон: a row of short points. Used for "Как работи" (numbered, bordered cards)
  and for the "Защо Хамелеон" trust row (plain, on the grey scheme).
{%- endcomment -%}
{%- style -%}
  .hm-points-{{ section.id }} {
    padding: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px 0 {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .hm-points-{{ section.id }} {
      padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    }

    .hm-points-{{ section.id }} .hm-points__list {
      grid-template-columns: repeat({{ section.blocks.size | at_least: 1 | at_most: 4 }}, minmax(0, 1fr));
    }
  }
{%- endstyle -%}
{%- style -%}
  .hm-points__inner {
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }

  .hm-points__title {
    font-size: 2.4rem;
  }

  .hm-points__list {
    display: grid;
    gap: 1.2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hm-points__item {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .hm-points--cards .hm-points__item {
    padding: 2rem;
    border: 1px solid var(--hm-border);
    border-radius: var(--hm-radius-md);
  }

  .hm-points__num {
    font-family: var(--hm-font-display);
    font-weight: 800;
    color: var(--hm-in-stock);
  }

  .hm-points__item-title {
    font-family: var(--hm-font-display);
    font-size: 1.7rem;
    font-weight: 700;
    color: var(--hm-text-strong);
  }

  .hm-points--plain .hm-points__item-title {
    font-size: 1.6rem;
  }

  .hm-points--plain .hm-points__item-text {
    font-size: 1.5rem;
  }
{%- endstyle -%}

<section class="hm-section hm-points-{{ section.id }} hm-points--{{ section.settings.style }} color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width hm-points__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="hm-heading hm-points__title">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.style == 'cards' -%}
      <ol class="hm-points__list">
    {%- else -%}
      <ul class="hm-points__list" aria-label="{{ section.settings.heading | default: section.settings.label | escape }}">
    {%- endif -%}
    {%- for block in section.blocks -%}
      <li class="hm-points__item" {{ block.shopify_attributes }}>
        {%- if section.settings.style == 'cards' -%}
          <span class="hm-points__num" aria-hidden="true">{{ forloop.index }}</span>
        {%- endif -%}
        <span class="hm-points__item-title">{{ block.settings.title | escape }}</span>
        <span class="hm-points__item-text">{{ block.settings.text | escape }}</span>
      </li>
    {%- endfor -%}
    {%- if section.settings.style == 'cards' -%}
      </ol>
    {%- else -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Хамелеон: points",
  "tag": "div",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "label", "label": "Label when there is no heading (for screen readers)", "default": "Защо Хамелеон" },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "default": "cards",
      "options": [
        { "value": "cards", "label": "Numbered cards" },
        { "value": "plain", "label": "Plain row" }
      ]
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 32 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 32 }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Изберете цвят" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "От каталога онлайн или по код, който вече имате." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Хамелеон: points",
      "settings": { "heading": "Как работи" },
      "blocks": [
        { "type": "point", "settings": { "title": "Изберете цвят", "text": "От каталога онлайн или по код, който вече имате." } },
        { "type": "point", "settings": { "title": "Изчислете количеството", "text": "Квадратура, слоеве и разходна норма. Без излишни кофи." } },
        { "type": "point", "settings": { "title": "Запазете и вземете", "text": "Тонираме я и Ви се обаждаме. Плащате в магазина." } }
      ]
    }
  ]
}
{% endschema %}
