{%- comment -%}
  Хамелеон: paint product page, under the product (template product.paint).
  A room whose wall takes the chosen colour, the Vitex (or Motivo, for plasters) colours, and the
  calculator for this paint. The chosen colour also fills the colour box above "Add to cart"
  (snippets/hameleon-product-color.liquid). Each "product" block is one paint, as on the catalogue page.
  Logic: assets/hameleon-catalogue.js and assets/hameleon-calculator.js.
{%- endcomment -%}
{%- liquid
  assign title_down = product.title | downcase
  assign type_down = product.type | downcase
  assign only = 'vitex'
  if title_down contains 'мазилк' or type_down contains 'мазилк'
    assign only = 'motivo'
  endif
  comment
    Each Motivo base has its own colours: Silver SS-…, Gold GG-…, Titanium TT-….
  endcomment
  assign base = ''
  assign base_prefix = ''
  if only == 'motivo'
    if title_down contains 'silver' or title_down contains 'сребр'
      assign base = 'silver'
      assign base_prefix = 'SS'
    elsif title_down contains 'gold' or title_down contains 'злат'
      assign base = 'gold'
      assign base_prefix = 'GG'
    elsif title_down contains 'titan' or title_down contains 'титан'
      assign base = 'titanium'
      assign base_prefix = 'TT'
    endif
  endif
  assign tintable = true
  if product.tags contains 'без тониране'
    assign tintable = false
  endif
-%}
{{ 'hameleon-catalogue.css' | asset_url | stylesheet_tag }}
<script src="{{ 'hameleon-colors.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'hameleon-catalogue.js' | asset_url }}" defer="defer"></script>

{%- if tintable -%}
  <hameleon-catalogue class="hm-section hm-cat hm-cat--product" style="display: block;" data-only="{{ only }}" data-no-default{% if base != blank %} data-base="{{ base }}"{% endif %} data-motivo-base="{{ 'hm-mz-ss-001.jpg' | asset_url }}">
{%- else -%}
  <div class="hm-section hm-cat hm-cat--product">
{%- endif -%}
  <div class="page-width">
    {%- if tintable -%}
      <div class="hm-cat__head">
        {%- if section.settings.eyebrow != blank -%}
          <p class="hm-eyebrow" data-reveal>{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="hm-cat__title" data-reveal style="--d: 1">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}
          <p class="hm-sub" data-reveal style="--d: 2">{{ section.settings.text | escape }}</p>
        {%- endif -%}
      </div>
      {%- render 'hameleon-color-studio', only: only, base_prefix: base_prefix -%}
    {%- endif -%}

    <div class="hm-cat__calc" id="kalkulator">
      <div class="hm-cat__calc-head">
        <p class="hm-eyebrow">{{ section.settings.calc_eyebrow | escape }}</p>
        <h2 class="hm-h2">{{ section.settings.calc_heading | escape }}</h2>
        {%- if section.settings.calc_text != blank -%}
          <p class="hm-sub">{{ section.settings.calc_text | escape }}</p>
        {%- endif -%}
      </div>
      {%- render 'hameleon-paint-calc', section: section, product: product, in_catalogue: true -%}
    </div>
  </div>
{%- if tintable -%}
  </hameleon-catalogue>
{%- else -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Хамелеон: paint product",
  "tag": "div",
  "class": "section",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "max_blocks": 40,
  "settings": [
    {
      "type": "paragraph",
      "content": "For paint product pages: a room in the chosen colour, the colour catalogue and the calculator for this paint. Add the same paints as blocks as in the catalogue page, so coverage and pack sizes match. Without a matching block the calculator uses 10 m² per litre and the sizes in the variant names."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Изберете цвят"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Вижте цвета на стената"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Изберете цвят или въведете кода от мострата. Стаята се боядисва веднага, а кодът отива в поръчката заедно с боята."
    },
    {
      "type": "text",
      "id": "calc_eyebrow",
      "label": "Calculator eyebrow",
      "default": "Калкулатор и поръчка"
    },
    {
      "type": "text",
      "id": "calc_heading",
      "label": "Calculator heading",
      "default": "Колко опаковки Ви трябват?"
    },
    {
      "type": "textarea",
      "id": "calc_text",
      "label": "Calculator text",
      "default": "Въведете площта. Пресмятаме литрите и най-изгодните опаковки и ги добавяме в количката с кода на цвета."
    },
    {
      "type": "select",
      "id": "default_coats",
      "label": "Coats selected at start",
      "default": "2",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        }
      ]
    },
    {
      "type": "number",
      "id": "default_area",
      "label": "Area shown at start (m²)",
      "default": 40
    },
    {
      "type": "richtext",
      "id": "warning",
      "label": "Warning under the result",
      "default": "<p><strong>Важно!</strong> По технология преди всяка боя трябва да има <strong>грунд</strong> и да се минат <strong>две ръце</strong>.</p>"
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "Small note at the end",
      "default": "Цветът на екрана е ориентировъчен. Вижте мострата в магазина, ако се колебаете."
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Paint",
      "settings": [
        {
          "type": "select",
          "id": "category",
          "label": "Category",
          "default": "interior",
          "options": [
            {
              "value": "interior",
              "label": "Интериорна боя"
            },
            {
              "value": "exterior",
              "label": "Фасадна боя"
            },
            {
              "value": "plaster",
              "label": "Мазилки"
            }
          ]
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Vitex Vito"
        },
        {
          "type": "text",
          "id": "class",
          "label": "Class",
          "default": "Среден клас"
        },
        {
          "type": "text",
          "id": "note",
          "label": "Note (e.g. Само бяло)"
        },
        {
          "type": "checkbox",
          "id": "tintable",
          "label": "Can be tinted",
          "default": true,
          "info": "Off for white-only paints: they go to the cart without a colour code."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo of the tin (optional)",
          "info": "Without a photo or a linked product, the tin is drawn."
        },
        {
          "type": "text",
          "id": "pack_litres",
          "label": "Coverage: one pack of … litres",
          "default": "1",
          "info": "With the next field: one pack of this many litres covers that many m² in one coat."
        },
        {
          "type": "text",
          "id": "pack_sqm",
          "label": "Coverage: … covers this many m² (one coat)",
          "default": "11"
        },
        {
          "type": "text",
          "id": "sizes",
          "label": "Pack sizes sold, in litres, comma separated",
          "default": "1, 3, 9, 15",
          "info": "Use a dot for decimals, e.g. 0.905"
        },
        {
          "type": "text",
          "id": "white_sizes",
          "label": "Sizes sold only in white",
          "info": "Never tinted, so the calculator leaves them out for a colour. E.g. 15 for Vitex Vito."
        },
        {
          "type": "product",
          "id": "product",
          "label": "Shopify product (for price and add to cart)",
          "info": "Name the variants by pack size, e.g. \"1 л\", \"3 л\", \"9 л\". Each size the calculator picks must have a variant."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Or a link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Хамелеон: paint product"
    }
  ]
}
{% endschema %}
