{%- comment -%}
  Хамелеон: quick paint calculator on the home page.
  litres = area × coats ÷ coverage; then the cheapest mix of can sizes that covers it.
  The full room calculator (walls, doors, windows, per-product coverage) comes in Phase 4.
{%- endcomment -%}
<script src="{{ 'hameleon-calculator.js' | asset_url }}" defer="defer"></script>
{%- style -%}
  .hm-calc-{{ section.id }} {
    padding: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px 0 {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .hm-calc-{{ section.id }} {
      padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}
{%- style -%}
  .hm-calc__box {
    display: grid;
    gap: 2rem;
    padding: 2rem 1.6rem;
    border-radius: var(--hm-radius-lg);
    background: var(--hm-surface-sunken);
  }

  .hm-calc__intro {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .hm-calc__title {
    font-size: 2.4rem;
  }

  .hm-calc__form {
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
    padding: 1.6rem;
    border-radius: var(--hm-radius-md);
    background: var(--hm-surface);
  }

  .hm-calc__field {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .hm-calc__label {
    padding: 0;
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--hm-text-strong);
  }

  .hm-calc__stepper {
    display: grid;
    grid-template-columns: 4.4rem minmax(0, 1fr) 4.4rem;
    gap: 0.8rem;
    align-items: center;
  }

  .hm-calc__step {
    width: 4.4rem;
    height: 4.4rem;
    border: 1px solid var(--hm-border-strong);
    border-radius: var(--hm-radius-md);
    background: var(--hm-surface);
    color: var(--hm-text-strong);
    font-size: 2.2rem;
    line-height: 1;
    cursor: pointer;
  }

  .hm-calc__area {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    height: 4.4rem;
    border: 1px solid var(--hm-border-strong);
    border-radius: var(--hm-radius-md);
    font-family: var(--hm-font-display);
    font-size: 2rem;
    font-weight: 800;
    color: var(--hm-text-strong);
  }

  .hm-calc__area input {
    width: 6ch;
    border: 0;
    background: transparent;
    font: inherit;
    color: inherit;
    text-align: right;
    font-variant-numeric: tabular-nums;
    -moz-appearance: textfield;
  }

  .hm-calc__area input::-webkit-inner-spin-button,
  .hm-calc__area input::-webkit-outer-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .hm-calc__coats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
  }

  .hm-calc__coat {
    position: relative;
  }

  .hm-calc__coat input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }

  .hm-calc__coat span {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 4.4rem;
    border: 1px solid var(--hm-border-strong);
    border-radius: var(--hm-radius-md);
    background: var(--hm-surface);
    color: var(--hm-text-strong);
    font-family: var(--hm-font-display);
    font-size: 1.5rem;
    font-weight: 600;
  }

  .hm-calc__coat input:checked + span {
    border: 2px solid var(--hm-primary);
    background: var(--hm-in-stock-bg);
    color: var(--hm-in-stock);
    font-weight: 700;
  }

  .hm-calc__coat input:focus-visible + span {
    outline: 3px solid var(--hm-link);
    outline-offset: 2px;
  }

  .hm-calc__result {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--hm-border);
  }

  .hm-calc__litres {
    font-family: var(--hm-font-display);
    font-size: 2rem;
    font-weight: 800;
    color: var(--hm-text-strong);
  }

  .hm-calc__cans {
    font-size: 1.7rem;
    font-weight: 600;
    color: var(--hm-text-strong);
  }

  .hm-calc__note {
    font-size: 1.4rem;
    color: var(--hm-text-muted);
  }

  @media screen and (min-width: 750px) {
    .hm-calc__box {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 4rem;
      align-items: center;
      padding: 3.2rem;
    }

    .hm-calc__intro .hm-btn {
      align-self: flex-start;
    }
  }
{%- endstyle -%}

<section id="kalkulator" class="hm-section hm-calc-{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="hm-calc__box">
      <div class="hm-calc__intro">
        <h2 class="hm-heading hm-calc__title">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}
          <p class="hm-lead" style="font-size: 1.6rem;">{{ section.settings.text | escape }}</p>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a class="hm-btn hm-btn--primary" href="{{ section.settings.button_link | default: '#' }}">
            {{- section.settings.button_label | escape -}}
          </a>
        {%- endif -%}
      </div>

      <hameleon-paint-calc
        class="hm-calc__form"
        data-coverage="{{ section.settings.coverage }}"
        data-sizes="{{ section.settings.sizes | escape }}"
      >
        <div class="hm-calc__field">
          <label class="hm-calc__label" for="HmCalcArea-{{ section.id }}">Площ на стените</label>
          <div class="hm-calc__stepper">
            <button type="button" class="hm-calc__step" data-step="-5" aria-label="5 м² по-малко">−</button>
            <span class="hm-calc__area">
              <input
                id="HmCalcArea-{{ section.id }}"
                type="number"
                inputmode="decimal"
                min="1"
                max="2000"
                step="1"
                value="{{ section.settings.default_area }}"
                data-area
              >
              <span aria-hidden="true">м²</span>
            </span>
            <button type="button" class="hm-calc__step" data-step="5" aria-label="5 м² повече">+</button>
          </div>
        </div>

        <fieldset class="hm-calc__field">
          <legend class="hm-calc__label">Слоеве</legend>
          <div class="hm-calc__coats">
            <label class="hm-calc__coat">
              <input type="radio" name="HmCalcCoats-{{ section.id }}" value="1" data-coats>
              <span>1 слой</span>
            </label>
            <label class="hm-calc__coat">
              <input type="radio" name="HmCalcCoats-{{ section.id }}" value="2" data-coats checked>
              <span>2 слоя</span>
            </label>
          </div>
        </fieldset>

        <div class="hm-calc__result" aria-live="polite">
          <span class="hm-calc__litres" data-litres></span>
          <span class="hm-calc__cans" data-cans></span>
        </div>
        {%- if section.settings.note != blank -%}
          <p class="hm-calc__note" style="margin: 0;">{{ section.settings.note | escape }}</p>
        {%- endif -%}
      </hameleon-paint-calc>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Хамелеон: calculator",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Колко боя ми трябва?" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Въведете квадратурата на стените и слоевете. Ще Ви кажем колко литра и кои разфасовки." },
    { "type": "text", "id": "button_label", "label": "Button label (shown when the full calculator page exists)" },
    { "type": "url", "id": "button_link", "label": "Button link (full calculator page)" },
    { "type": "number", "id": "default_area", "label": "Starting wall area, m²", "default": 42 },
    { "type": "number", "id": "coverage", "label": "Coverage, m² per litre per coat", "default": 9 },
    { "type": "text", "id": "sizes", "label": "Can sizes in litres, comma separated", "default": "10, 5, 2.5" },
    { "type": "textarea", "id": "note", "label": "Note under the result", "default": "Пример при разходна норма 9 м²/л. Точните норми и разфасовки идват от избрания продукт. Проверяваме сметката и на щанда." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 32 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 32 }
  ],
  "presets": [{ "name": "Хамелеон: calculator" }]
}
{% endschema %}
