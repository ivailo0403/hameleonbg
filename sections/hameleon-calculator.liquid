{%- comment -%}
  Хамелеон: paint calculator section (based on Ivaylo's Seliton calculator).
  The calculator itself is snippets/hameleon-paint-calc.liquid; each "product" block is one paint.
{%- endcomment -%}
{%- style -%}
  .hm-calc-{{ section.id }} {
    padding: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px 0 {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    background:
      radial-gradient(60rem 40rem at 100% 0%, rgba(0, 170, 193, 0.12), transparent 60%),
      radial-gradient(50rem 40rem at 0% 100%, rgba(25, 165, 74, 0.12), transparent 60%),
      var(--hm-surface-sunken);
  }

  .hm-calc-{{ section.id }} .hm-calc__head {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    margin-bottom: 3.2rem;
  }

  @media screen and (min-width: 750px) {
    .hm-calc-{{ section.id }} {
      padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- assign catalogue_url = settings.hm_catalogue_page | default: '/pages/katalog-tsvetove' -%}
<section id="kalkulator" class="hm-section hm-calc-{{ section.id }}">
  <div class="page-width">
    <div class="hm-calc__head hm-section-head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="hm-eyebrow" data-reveal>{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="hm-h2" data-reveal style="--d: 1">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="hm-sub" data-reveal style="--d: 2">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>
    <div data-reveal style="--d: 2">
      {%- render 'hameleon-paint-calc', section: section, catalogue_url: catalogue_url -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Хамелеон: calculator",
  "tag": "div",
  "class": "section",
  "max_blocks": 40,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Калкулатор" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Колко боя ми трябва?" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Изберете боята, въведете квадратурата и вижте точно колко литра и кои опаковки Ви трябват." },
    {
      "type": "select",
      "id": "default_coats",
      "label": "Coats selected at start",
      "default": "2",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" }
      ]
    },
    { "type": "number", "id": "default_area", "label": "Area shown at start (m²)", "default": 40 },
    { "type": "richtext", "id": "warning", "label": "Warning under the result", "default": "<p><strong>Важно!</strong> По технология преди всяка боя трябва да има <strong>грунд</strong> и да се минат <strong>две ръце</strong>.</p>" },
    { "type": "text", "id": "footnote", "label": "Small note at the end", "default": "Разходната норма зависи от основата. Проверяваме сметката и на щанда." },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 48 }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Paint",
      "settings": [
        {
          "type": "select",
          "id": "category",
          "label": "Category",
          "default": "interior",
          "options": [
            { "value": "interior", "label": "Интериорна боя" },
            { "value": "exterior", "label": "Фасадна боя" },
            { "value": "plaster", "label": "Мазилки" }
          ]
        },
        { "type": "text", "id": "name", "label": "Name", "default": "Vitex Vito" },
        { "type": "text", "id": "class", "label": "Class", "default": "Среден клас" },
        { "type": "text", "id": "note", "label": "Note (e.g. Само бяло)" },
        { "type": "checkbox", "id": "tintable", "label": "Can be tinted", "default": true, "info": "Off for white-only paints: they go to the cart without a colour code." },
        { "type": "image_picker", "id": "image", "label": "Photo of the tin (optional)", "info": "Without a photo or a linked product, the tin is drawn." },
        { "type": "text", "id": "pack_litres", "label": "Coverage: one pack of … litres", "default": "1", "info": "With the next field: one pack of this many litres covers that many m² in one coat." },
        { "type": "text", "id": "pack_sqm", "label": "Coverage: … covers this many m² (one coat)", "default": "11" },
        { "type": "text", "id": "sizes", "label": "Pack sizes sold, in litres, comma separated", "default": "1, 3, 9, 15", "info": "Use a dot for decimals, e.g. 0.905" },
        { "type": "text", "id": "white_sizes", "label": "Sizes sold only in white", "info": "Never tinted, so the calculator leaves them out for a colour. E.g. 15 for Vitex Vito." },
        { "type": "product", "id": "product", "label": "Shopify product (for price and add to cart)", "info": "Name the variants by pack size, e.g. \"1 л\", \"3 л\", \"9 л\". Each size the calculator picks must have a variant." },
        { "type": "url", "id": "link", "label": "Or a link (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Хамелеон: calculator",
      "blocks": [
        { "type": "product", "settings": { "category": "interior", "name": "Vitex Vi", "class": "Нисък клас", "note": "Само бяло", "tintable": false, "pack_litres": "3", "pack_sqm": "19", "sizes": "3, 9, 15" } },
        { "type": "product", "settings": { "category": "interior", "name": "Vitex Vipol", "class": "Средно-нисък клас", "note": "Само бяло", "tintable": false, "pack_litres": "1", "pack_sqm": "9", "sizes": "3, 9, 15" } },
        { "type": "product", "settings": { "category": "interior", "name": "Vitex Vito", "class": "Среден клас", "pack_litres": "1", "pack_sqm": "11", "sizes": "1, 3, 9, 15", "white_sizes": "15" } },
        { "type": "product", "settings": { "category": "interior", "name": "Vitex Aspire", "class": "Средно-висок клас", "pack_litres": "1", "pack_sqm": "12", "sizes": "1, 3, 10" } },
        { "type": "product", "settings": { "category": "interior", "name": "Vitex Classic", "class": "Висок клас", "pack_litres": "1", "pack_sqm": "15", "sizes": "1, 3, 10" } },
        { "type": "product", "settings": { "category": "interior", "name": "Vitex Kitchen & Bath", "class": "Антибактериална", "note": "Кухня и баня", "pack_litres": "1", "pack_sqm": "14", "sizes": "1, 3" } },
        { "type": "product", "settings": { "category": "exterior", "name": "Vitex Vito Acrylic", "class": "Среден клас", "pack_litres": "1", "pack_sqm": "11", "sizes": "1, 3, 10, 15" } },
        { "type": "product", "settings": { "category": "exterior", "name": "Vitex Acrylan", "class": "Висок клас", "pack_litres": "1", "pack_sqm": "15", "sizes": "1, 3, 10" } },
        { "type": "product", "settings": { "category": "plaster", "name": "Vitex Motivo Silver", "class": "База", "pack_litres": "0.905", "pack_sqm": "12", "sizes": "0.905, 2.715" } },
        { "type": "product", "settings": { "category": "plaster", "name": "Vitex Motivo Gold", "class": "База", "pack_litres": "0.905", "pack_sqm": "12", "sizes": "0.905, 2.715" } },
        { "type": "product", "settings": { "category": "plaster", "name": "Vitex Motivo Titanium", "class": "База", "pack_litres": "0.905", "pack_sqm": "12", "sizes": "0.905, 2.715" } }
      ]
    }
  ]
}
{% endschema %}
