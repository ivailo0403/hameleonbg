{%- comment -%}
  Хамелеон: "Хитове в магазина". Tabs of real products (one tab per block: a collection, or the
  newest products in the store), each with the collection's product cards and "Виж всички".
  A tab with no products is left out; the section hides itself when no tab has products.
  Cards: snippets/hameleon-product-card.liquid (same as the collection pages).
{%- endcomment -%}
{%- liquid
  assign limit = section.settings.limit
  assign tab_count = 0
  for block in section.blocks
    if block.settings.source == 'newest'
      assign tab_count = tab_count | plus: 1
    elsif block.settings.collection != blank and block.settings.collection.products_count > 0
      assign tab_count = tab_count | plus: 1
    endif
  endfor
-%}
{%- if tab_count > 0 -%}
{{ 'hameleon-collection.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- style -%}
  .hm-show {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(60rem 30rem at 100% 0%, rgba(0, 170, 193, 0.09), transparent 70%),
      radial-gradient(50rem 30rem at 0% 100%, rgba(25, 165, 74, 0.08), transparent 70%),
      var(--hm-surface-sunken, #f4f6f5);
  }

  .hm-show__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.6rem 3.2rem;
    margin-bottom: 2.4rem;
  }

  .hm-show__head .hm-sub {
    max-width: 52rem;
    margin-top: 1rem;
  }

  .hm-show__tabs {
    display: flex;
    gap: 0.8rem;
    margin: 0 -1.6rem 2.4rem;
    padding: 0.4rem 1.6rem;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .hm-show__tabs::-webkit-scrollbar {
    display: none;
  }

  .hm-show__tab {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 0.8rem;
    min-height: 4.6rem;
    padding: 0.6rem 1.8rem 0.6rem 0.6rem;
    border: 1px solid var(--hm-border);
    border-radius: 99rem;
    background: #ffffff;
    font-family: var(--hm-font-display);
    font-size: 1.45rem;
    font-weight: 800;
    color: var(--hm-text-strong);
    cursor: pointer;
    transition: background 0.25s, color 0.25s, border-color 0.25s, box-shadow 0.25s;
  }

  .hm-show__tab i {
    display: grid;
    place-items: center;
    width: 3.4rem;
    height: 3.4rem;
    border-radius: 50%;
    background: var(--hm-surface-sunken, #eef1f0);
    color: var(--hm-green-dark, #12803a);
    transition: background 0.25s, color 0.25s;
  }

  .hm-show__tab i svg {
    width: 1.8rem;
    height: 1.8rem;
  }

  .hm-show__tab small {
    font-family: var(--hm-font-body);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--hm-text-muted);
  }

  .hm-show__tab:hover {
    border-color: var(--hm-text-strong);
  }

  .hm-show__tab[aria-selected='true'] {
    border-color: #141618;
    background: #141618;
    color: #ffffff;
    box-shadow: var(--hm-shadow-md);
  }

  .hm-show__tab[aria-selected='true'] i {
    background: var(--hm-gradient, linear-gradient(135deg, #19a54a, #00aac1));
    color: #ffffff;
  }

  .hm-show__tab[aria-selected='true'] small {
    color: #b9c0bd;
  }

  /* Phone: cards scroll sideways. Desktop: a 4-column grid. */
  .hm-show__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(23rem, 68vw);
    gap: 1.2rem;
    margin: 0 -1.6rem;
    padding: 0.4rem 1.6rem 1.6rem;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding: 0 1.6rem;
    scrollbar-width: thin;
  }

  .hm-show__track > li {
    scroll-snap-align: start;
  }

  .hm-show__panel[hidden] {
    display: none;
  }

  .hm-show__panel.is-in .hm-show__track > li {
    animation: hm-show-in 0.45s var(--hm-ease) both;
    animation-delay: calc(var(--i, 0) * 0.05s);
  }

  @keyframes hm-show-in {
    from {
      opacity: 0;
      transform: translateY(1.2rem);
    }
  }

  .hm-show__more {
    display: flex;
    justify-content: center;
    margin-top: 1.6rem;
  }

  .hm-show__all {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 800;
    color: var(--hm-text-strong);
    text-decoration: none;
    border-bottom: 2px solid currentColor;
    padding-bottom: 0.2rem;
  }

  .hm-show__all span {
    transition: transform 0.25s var(--hm-ease);
  }

  .hm-show__all:hover span {
    transform: translateX(4px);
  }

  @media screen and (min-width: 750px) {
    .hm-show__track {
      grid-auto-columns: minmax(26rem, 38vw);
    }
  }

  @media screen and (min-width: 990px) {
    .hm-show__tabs {
      flex-wrap: wrap;
      margin: 0 0 3.2rem;
      padding: 0;
      overflow: visible;
    }

    .hm-show__track {
      grid-auto-flow: row;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-auto-columns: auto;
      gap: 2rem;
      margin: 0;
      padding: 0;
      overflow: visible;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hm-show__panel.is-in .hm-show__track > li {
      animation: none;
    }
  }
{%- endstyle -%}

<section class="hm-section hm-space hm-show" id="hitove">
  <div class="page-width">
    <div class="hm-show__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="hm-eyebrow" data-reveal>{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="hm-h2" data-reveal style="--d: 1">
          {{- section.settings.heading | escape -}}
          {%- if section.settings.highlight != blank %} <span class="hm-gradient-text">{{ section.settings.highlight | escape }}</span>{% endif -%}
        </h2>
        {%- if section.settings.text != blank -%}
          <p class="hm-sub" data-reveal style="--d: 2">{{ section.settings.text | escape }}</p>
        {%- endif -%}
      </div>
    </div>

    <hameleon-showcase>
      <div class="hm-show__tabs" role="tablist" aria-label="{{ section.settings.heading | escape }}" data-reveal style="--d: 2">
        {%- assign first = true -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign c = block.settings.collection
            if block.settings.source == 'newest'
              assign count = collections.all.products_count
            elsif c != blank
              assign count = c.products_count
            else
              assign count = 0
            endif
          -%}
          {%- if count > 0 -%}
            <button
              type="button"
              class="hm-show__tab"
              role="tab"
              id="HmShowTab-{{ block.id }}"
              aria-controls="HmShowPanel-{{ block.id }}"
              aria-selected="{{ first }}"
              tabindex="{% if first %}0{% else %}-1{% endif %}"
              {{ block.shopify_attributes }}
            >
              <i>{%- render 'hameleon-icon', icon: block.settings.icon -%}</i>
              {{- block.settings.label | default: c.title | escape }}
              <small>{{ count }}</small>
            </button>
            {%- assign first = false -%}
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- assign first = true -%}
      {%- for block in section.blocks -%}
        {%- liquid
          assign c = block.settings.collection
          if block.settings.source == 'newest'
            assign products = collections.all.products | sort: 'created_at' | reverse
            assign all_url = routes.all_products_collection_url
          elsif c != blank and c.products_count > 0
            assign products = c.products
            assign all_url = c.url
          else
            continue
          endif
        -%}
        <div
          class="hm-show__panel{% if first %} is-in{% endif %}"
          role="tabpanel"
          id="HmShowPanel-{{ block.id }}"
          aria-labelledby="HmShowTab-{{ block.id }}"
          {% unless first %}hidden{% endunless %}
        >
          <ul class="hm-show__track">
            {%- for product in products limit: limit -%}
              <li style="--i: {{ forloop.index0 }}">
                {%- render 'hameleon-product-card', card_product: product, section_id: section.id, lazy_load: true -%}
              </li>
            {%- endfor -%}
          </ul>
          <div class="hm-show__more">
            <a class="hm-show__all" href="{{ all_url }}">
              Виж всички: {{ block.settings.label | default: c.title | escape }} <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
        {%- assign first = false -%}
      {%- endfor -%}
    </hameleon-showcase>
  </div>
</section>

<script>
  if (!customElements.get('hameleon-showcase')) {
    customElements.define(
      'hameleon-showcase',
      class extends HTMLElement {
        connectedCallback() {
          this.tabs = [...this.querySelectorAll('[role="tab"]')];
          this.tabs.forEach((tab, i) => {
            tab.addEventListener('click', () => this.show(tab));
            tab.addEventListener('keydown', (event) => {
              const step = { ArrowRight: 1, ArrowLeft: -1 }[event.key];
              if (!step) return;
              event.preventDefault();
              const next = this.tabs[(i + step + this.tabs.length) % this.tabs.length];
              next.focus();
              this.show(next);
            });
          });
        }

        show(tab) {
          this.tabs.forEach((t) => {
            const on = t === tab;
            t.setAttribute('aria-selected', String(on));
            t.tabIndex = on ? 0 : -1;
            const panel = document.getElementById(t.getAttribute('aria-controls'));
            panel.hidden = !on;
            panel.classList.toggle('is-in', on);
          });
          tab.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'smooth' });
        }
      }
    );
  }
</script>
{%- endif -%}

{% schema %}
{
  "name": "Хамелеон: хитове",
  "tag": "div",
  "class": "section",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "От рафтовете в магазина" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Хитове в" },
    { "type": "text", "id": "highlight", "label": "Highlighted words", "default": "Хамелеон" },
    { "type": "text", "id": "text", "label": "Text", "default": "Инструментите, които клиентите ни взимат най-често. Добавете в количката и ги вземете от магазина." },
    { "type": "range", "id": "limit", "label": "Products per tab", "min": 4, "max": 12, "step": 4, "default": 8 }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "select",
          "id": "source",
          "label": "Products",
          "options": [
            { "value": "collection", "label": "From a collection" },
            { "value": "newest", "label": "Newest in the store" }
          ],
          "default": "collection"
        },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Tab label" },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "power", "label": "Power tools" },
            { "value": "hammerdrill", "label": "Drill" },
            { "value": "screwdriver", "label": "Screwdriver" },
            { "value": "grinder", "label": "Grinder" },
            { "value": "saw", "label": "Saw" },
            { "value": "hand", "label": "Hand tools" },
            { "value": "garden", "label": "Garden" },
            { "value": "fasteners", "label": "Fasteners" },
            { "value": "battery", "label": "Battery" },
            { "value": "kit", "label": "Kit" },
            { "value": "paint", "label": "Paint" },
            { "value": "plus", "label": "New" }
          ],
          "default": "power"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Хамелеон: хитове",
      "blocks": [
        { "type": "tab", "settings": { "collection": "elektroinstrumenti", "label": "Електроинструменти", "icon": "power" } },
        { "type": "tab", "settings": { "collection": "ruchni-instrumenti", "label": "Ръчни инструменти", "icon": "hand" } },
        { "type": "tab", "settings": { "collection": "gradina", "label": "Градина", "icon": "garden" } },
        { "type": "tab", "settings": { "source": "newest", "label": "Нови", "icon": "plus" } }
      ]
    }
  ]
}
{% endschema %}
