{%- comment -%}
  Хамелеон: closing call to action on the deep brand gradient, with drifting colour dots.
{%- endcomment -%}
{%- style -%}
  .hm-cta-wrap {
    padding: 0 0 6.4rem;
  }

  .hm-cta {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2rem;
    padding: 4.8rem 2.4rem;
    border-radius: 2.4rem;
    background: var(--hm-gradient-deep);
    color: #ffffff;
    box-shadow: var(--hm-shadow-lg);
  }

  .hm-cta__title {
    position: relative;
    margin: 0;
    max-width: 64rem;
    font-family: var(--hm-font-display);
    font-size: clamp(3rem, 4.6vw, 5.2rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: #ffffff;
    text-shadow: 0 2px 24px rgba(0, 40, 30, 0.25);
  }

  .hm-cta__text {
    position: relative;
    margin: 0;
    max-width: 52rem;
    font-size: 1.7rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.92);
  }

  .hm-cta__buttons {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
  }

  .hm-cta__dots span {
    position: absolute;
    border-radius: 50%;
    border: 4px solid rgba(255, 255, 255, 0.85);
    box-shadow: var(--hm-shadow-md);
    animation: hm-float 6s ease-in-out infinite;
    animation-delay: calc(var(--i) * -1.1s);
  }

  @media screen and (min-width: 990px) {
    .hm-cta-wrap {
      padding-bottom: 10.4rem;
    }

    .hm-cta {
      padding: 8rem 7.2rem;
    }
  }

  @media screen and (max-width: 989px) {
    .hm-cta__dots {
      display: none;
    }
  }

  @media screen and (max-width: 749px) {
    .hm-cta__buttons .hm-btn {
      width: 100%;
    }
  }
{%- endstyle -%}

<section class="hm-section hm-cta-wrap">
  <div class="page-width">
    <div class="hm-cta" data-reveal="scale">
      <div class="hm-cta__dots" aria-hidden="true">
        {%- assign dots = 'FED426:80%:18%:9,FE9A28:90%:56%:6,D771AF:75%:66%:7.5,96BC5E:93%:12%:5,F89495:71%:34%:4.5' | split: ',' -%}
        {%- for d in dots -%}
          {%- assign p = d | split: ':' -%}
          <span style="--i: {{ forloop.index0 }}; background: #{{ p[0] }}; left: {{ p[1] }}; top: {{ p[2] }}; width: {{ p[3] }}rem; height: {{ p[3] }}rem;"></span>
        {%- endfor -%}
      </div>
      <h2 class="hm-cta__title">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="hm-cta__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}
      <div class="hm-cta__buttons">
        {%- if section.settings.button_label_1 != blank -%}
          <a class="hm-btn hm-btn--light" href="{{ section.settings.button_link_1 | default: '#cvetove' }}">
            {{- section.settings.button_label_1 | escape }} <span class="hm-btn__arrow" aria-hidden="true">→</span>
          </a>
        {%- endif -%}
        {%- if section.settings.button_label_2 != blank -%}
          <a class="hm-btn hm-btn--ghost-light" href="{{ section.settings.button_link_2 | default: 'tel:' | append: settings.hm_store_phone_link }}">
            {{- section.settings.button_label_2 | escape -}}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Хамелеон: closing CTA",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Изберете цвят днес. Вземете го до 3 дни." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Поръчвате онлайн, ние тонираме и Ви се обаждаме, когато е готова." },
    { "type": "text", "id": "button_label_1", "label": "Primary button", "default": "Изберете цвят" },
    { "type": "url", "id": "button_link_1", "label": "Primary button link" },
    { "type": "text", "id": "button_label_2", "label": "Secondary button", "default": "Обадете се: 089 500 10 44" },
    { "type": "url", "id": "button_link_2", "label": "Secondary button link (defaults to the store phone)" }
  ],
  "presets": [{ "name": "Хамелеон: closing CTA" }]
}
{% endschema %}
