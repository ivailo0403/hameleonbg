{%- comment -%}
  Хамелеон: "Как работи" in three steps, each with a small product-style illustration
  (colour picker, calculator result, ready notification).
{%- endcomment -%}
{%- style -%}
  .hm-steps__grid {
    display: grid;
    gap: 1.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: hmstep;
  }

  .hm-step {
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
    height: 100%;
    padding: 2rem;
    box-sizing: border-box;
  }

  .hm-step__art {
    position: relative;
    height: 17rem;
    border-radius: 1.4rem;
    background: var(--hm-surface-sunken);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hm-step__num {
    font-family: var(--hm-font-display);
    font-size: 1.3rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    color: var(--hm-primary);
  }

  .hm-step__title {
    margin: 0;
    font-family: var(--hm-font-display);
    font-size: 2rem;
    font-weight: 800;
    color: var(--hm-text-strong);
  }

  .hm-step__text {
    margin: 0;
    color: var(--hm-text-muted);
  }

  /* Art 1: swatch grid with a selected chip */
  .hm-art-swatches {
    display: grid;
    grid-template-columns: repeat(5, 3.6rem);
    gap: 0.8rem;
  }

  .hm-art-swatches span {
    width: 3.6rem;
    height: 3.6rem;
    border-radius: 0.8rem;
    transition: transform 0.4s var(--hm-ease);
  }

  .hm-art-swatches span.is-picked {
    transform: scale(1.18);
    box-shadow: 0 0 0 3px #ffffff, 0 0 0 5px var(--hm-primary), var(--hm-shadow-md);
  }

  .hm-step:hover .hm-art-swatches span:not(.is-picked) {
    transform: scale(0.92);
  }

  /* Art 2: mini result */
  .hm-art-calc {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    width: 80%;
    padding: 1.4rem;
    border-radius: 1.2rem;
    background: #ffffff;
    box-shadow: var(--hm-shadow-md);
  }

  .hm-art-calc__row {
    display: flex;
    justify-content: space-between;
    font-size: 1.3rem;
    color: var(--hm-text-muted);
  }

  .hm-art-calc__row b {
    color: var(--hm-text-strong);
  }

  .hm-art-calc__bar {
    height: 0.8rem;
    border-radius: var(--hm-radius-pill);
    background: var(--hm-surface-sunken);
    overflow: hidden;
  }

  .hm-art-calc__bar i {
    display: block;
    height: 100%;
    width: 0;
    border-radius: inherit;
    background: var(--hm-gradient);
    transition: width 1.4s var(--hm-ease) 0.3s;
  }

  .is-in .hm-art-calc__bar i {
    width: 91%;
  }

  .hm-art-calc__pack {
    align-self: flex-start;
    padding: 0.4rem 1rem;
    border-radius: var(--hm-radius-sm);
    background: var(--hm-in-stock-bg);
    color: var(--hm-in-stock);
    font-family: var(--hm-font-display);
    font-size: 1.3rem;
    font-weight: 800;
  }

  /* Art 3: phone notification */
  .hm-art-phone {
    width: 15rem;
    height: 22rem;
    margin-top: 6rem;
    border-radius: 2.4rem;
    background: var(--hm-text-strong);
    padding: 1rem;
    box-shadow: var(--hm-shadow-lg);
  }

  .hm-art-phone__screen {
    height: 100%;
    border-radius: 1.6rem;
    background: linear-gradient(160deg, #0095ab, #19a54a);
    padding: 1.2rem 0.8rem;
  }

  .hm-art-note {
    display: flex;
    gap: 0.8rem;
    padding: 0.8rem;
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.95);
    font-size: 1.1rem;
    line-height: 1.35;
    color: var(--hm-text);
    transform: translateY(-1.2rem);
    opacity: 0;
    transition: transform 0.7s var(--hm-ease) 0.4s, opacity 0.7s var(--hm-ease) 0.4s;
  }

  .is-in .hm-art-note {
    transform: none;
    opacity: 1;
  }

  .hm-art-note b {
    display: block;
    color: var(--hm-text-strong);
  }

  .hm-art-note__logo {
    flex: 0 0 2.4rem;
    height: 2.4rem;
    border-radius: 0.6rem;
    background: var(--hm-gradient);
  }

  @media screen and (min-width: 750px) {
    .hm-steps__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2.4rem;
    }

    .hm-step {
      padding: 2.4rem;
    }
  }
{%- endstyle -%}

<section class="hm-section hm-space hm-steps" style="padding-top: 0;">
  <div class="page-width">
    <div class="hm-section-head hm-section-head--center">
      {%- if section.settings.eyebrow != blank -%}
        <p class="hm-eyebrow" data-reveal>{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="hm-h2" data-reveal style="--d: 1">{{ section.settings.heading | escape }}</h2>
    </div>

    <ol class="hm-steps__grid">
      <li data-reveal style="--d: 0">
        <div class="hm-step hm-card hm-card--hover">
          <div class="hm-step__art" aria-hidden="true">
            <div class="hm-art-swatches">
              {%- assign sw = 'E7CEB7,FED426,FE9A28,F89495,D771AF,CFC6B0,96BC5E,217553,0095AB,00627E' | split: ',' -%}
              {%- for c in sw -%}
                <span style="background: #{{ c }};"{% if forloop.index == 9 %} class="is-picked"{% endif %}></span>
              {%- endfor -%}
            </div>
          </div>
          <span class="hm-step__num">01</span>
          <h3 class="hm-step__title">{{ section.settings.step_1_title | escape }}</h3>
          <p class="hm-step__text">{{ section.settings.step_1_text | escape }}</p>
        </div>
      </li>
      <li data-reveal style="--d: 1">
        <div class="hm-step hm-card hm-card--hover">
          <div class="hm-step__art" aria-hidden="true">
            <div class="hm-art-calc">
              <div class="hm-art-calc__row"><span>45 м² · 2 ръце</span><b>8,2 л</b></div>
              <div class="hm-art-calc__bar"><i></i></div>
              <span class="hm-art-calc__pack">1 × 9 л</span>
            </div>
          </div>
          <span class="hm-step__num">02</span>
          <h3 class="hm-step__title">{{ section.settings.step_2_title | escape }}</h3>
          <p class="hm-step__text">{{ section.settings.step_2_text | escape }}</p>
        </div>
      </li>
      <li data-reveal style="--d: 2">
        <div class="hm-step hm-card hm-card--hover">
          <div class="hm-step__art" aria-hidden="true">
            <div class="hm-art-phone">
              <div class="hm-art-phone__screen">
                <div class="hm-art-note">
                  <span class="hm-art-note__logo"></span>
                  <span><b>Хамелеон</b>Поръчката Ви е готова. Чакаме Ви на бул. „България“ 21.</span>
                </div>
              </div>
            </div>
          </div>
          <span class="hm-step__num">03</span>
          <h3 class="hm-step__title">{{ section.settings.step_3_title | escape }}</h3>
          <p class="hm-step__text">{{ section.settings.step_3_text | escape }}</p>
        </div>
      </li>
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "Хамелеон: how it works",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Как работи" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Три стъпки до новия цвят" },
    { "type": "text", "id": "step_1_title", "label": "Step 1 title", "default": "Изберете цвят" },
    { "type": "textarea", "id": "step_1_text", "label": "Step 1 text", "default": "От каталога онлайн или по код, който вече имате." },
    { "type": "text", "id": "step_2_title", "label": "Step 2 title", "default": "Изчислете количеството" },
    { "type": "textarea", "id": "step_2_text", "label": "Step 2 text", "default": "Квадратура, ръце и разходна норма. Без излишни кофи." },
    { "type": "text", "id": "step_3_title", "label": "Step 3 title", "default": "Поръчайте онлайн" },
    { "type": "textarea", "id": "step_3_text", "label": "Step 3 text", "default": "Добавете боята в количката с кода на цвета. Тонираме до 3 работни дни и Ви се обаждаме." }
  ],
  "presets": [{ "name": "Хамелеон: how it works" }]
}
{% endschema %}
