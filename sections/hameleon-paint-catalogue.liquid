{%- comment -%}
  Хамелеон: paint catalogue page.
  Left: a room whose wall shows the chosen colour (sticky while the visitor scrolls the colours).
  Right: every Vitex colour (1320, by family, searchable by code or name) and the 124 Motivo plaster
  colours. Below: the calculator, which takes the chosen colour and adds the packs to the cart with
  the colour code on each line, and a summary of the paint already in the cart.
  Each "product" block is one paint for the calculator (same as the home page calculator).
  Logic: assets/hameleon-catalogue.js; colours: assets/hameleon-colors.js.
{%- endcomment -%}
{{ 'hameleon-catalogue.css' | asset_url | stylesheet_tag }}

<script src="{{ 'hameleon-colors.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'hameleon-catalogue.js' | asset_url }}" defer="defer"></script>

<hameleon-catalogue class="hm-section hm-cat" style="display: block;" data-motivo-base="{{ 'hm-mz-ss-001.jpg' | asset_url }}">
  <div class="page-width">
    <div class="hm-cat__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="hm-eyebrow" data-reveal>{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="hm-cat__title" data-reveal style="--d: 1">{{ section.settings.heading | escape }}</h1>
      {%- if section.settings.text != blank -%}
        <p class="hm-sub" data-reveal style="--d: 2">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>

    {%- render 'hameleon-color-studio' -%}

    <div class="hm-cat__calc" id="kalkulator">
      <div class="hm-cat__calc-head">
        <p class="hm-eyebrow">{{ section.settings.calc_eyebrow | escape }}</p>
        <h2 class="hm-h2">{{ section.settings.calc_heading | escape }}</h2>
        {%- if section.settings.calc_text != blank -%}
          <p class="hm-sub">{{ section.settings.calc_text | escape }}</p>
        {%- endif -%}
      </div>
      {%- render 'hameleon-paint-calc', section: section, in_catalogue: true -%}

      <div class="hm-cat__order" data-order hidden>
        <h3>Боя в количката</h3>
        <ul class="hm-cat__lines" data-order-lines></ul>
        <div class="hm-cat__order-foot">
          <p data-order-total></p>
          <a class="hm-btn hm-btn--primary" href="{{ routes.cart_url }}">Към количката <span class="hm-btn__arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </div>
</hameleon-catalogue>

{% schema %}
{
  "name": "Хамелеон: paint catalogue",
  "tag": "div",
  "class": "section",
  "max_blocks": 40,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Каталог на цветовете" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Вижте цвета на стената, преди да боядисате" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Изберете от 1320 цвята Vitex и 124 цвята мазилки Motivo. Стаята се боядисва веднага. После изчислете колко боя Ви трябва и я поръчайте с кода на цвета." },
    { "type": "text", "id": "calc_eyebrow", "label": "Calculator eyebrow", "default": "Калкулатор и поръчка" },
    { "type": "text", "id": "calc_heading", "label": "Calculator heading", "default": "Колко боя Ви трябва?" },
    { "type": "textarea", "id": "calc_text", "label": "Calculator text", "default": "Изберете боята и площта. Пресмятаме литрите и най-изгодните опаковки, а цветът отива в поръчката с кода си." },
    {
      "type": "select",
      "id": "default_coats",
      "label": "Coats selected at start",
      "default": "2",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" }
      ]
    },
    { "type": "number", "id": "default_area", "label": "Area shown at start (m²)", "default": 40 },
    { "type": "richtext", "id": "warning", "label": "Warning under the result", "default": "<p><strong>Важно!</strong> По технология преди всяка боя трябва да има <strong>грунд</strong> и да се минат <strong>две ръце</strong>.</p>" },
    { "type": "text", "id": "footnote", "label": "Small note at the end", "default": "Цветът на екрана е ориентировъчен. Вижте мострата в магазина, ако се колебаете." }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Paint",
      "settings": [
        {
          "type": "select",
          "id": "category",
          "label": "Category",
          "default": "interior",
          "options": [
            { "value": "interior", "label": "Интериорна боя" },
            { "value": "exterior", "label": "Фасадна боя" },
            { "value": "plaster", "label": "Мазилки" }
          ]
        },
        { "type": "text", "id": "name", "label": "Name", "default": "Vitex Vito" },
        { "type": "text", "id": "class", "label": "Class", "default": "Среден клас" },
        { "type": "text", "id": "note", "label": "Note (e.g. Само бяло)" },
        { "type": "checkbox", "id": "tintable", "label": "Can be tinted", "default": true, "info": "Off for white-only paints: they go to the cart without a colour code." },
        { "type": "image_picker", "id": "image", "label": "Photo of the tin (optional)", "info": "Without a photo or a linked product, the tin is drawn." },
        { "type": "text", "id": "pack_litres", "label": "Coverage: one pack of … litres", "default": "1", "info": "With the next field: one pack of this many litres covers that many m² in one coat." },
        { "type": "text", "id": "pack_sqm", "label": "Coverage: … covers this many m² (one coat)", "default": "11" },
        { "type": "text", "id": "sizes", "label": "Pack sizes sold, in litres, comma separated", "default": "1, 3, 9, 15", "info": "Use a dot for decimals, e.g. 0.905" },
        { "type": "text", "id": "white_sizes", "label": "Sizes sold only in white", "info": "Never tinted, so the calculator leaves them out for a colour. E.g. 15 for Vitex Vito." },
        { "type": "product", "id": "product", "label": "Shopify product (for price and add to cart)", "info": "Name the variants by pack size, e.g. \"1 л\", \"3 л\", \"9 л\". Each size the calculator picks must have a variant." },
        { "type": "url", "id": "link", "label": "Or a link (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Хамелеон: paint catalogue",
      "blocks": [
        { "type": "product", "settings": { "category": "interior", "name": "Vitex Vito", "class": "Среден клас", "pack_litres": "1", "pack_sqm": "11", "sizes": "1, 3, 9, 15", "white_sizes": "15" } }
      ]
    }
  ]
}
{% endschema %}
