{%- comment -%}
  Хамелеон: paint catalogue page.
  Left: a room whose wall shows the chosen colour (sticky while the visitor scrolls the colours).
  Right: every Vitex colour (1320, by family, searchable by code or name) and the 78 Motivo plaster
  colours. Below: the calculator, which takes the chosen colour and adds the packs to the cart with
  the colour code on each line, and a summary of the paint already in the cart.
  Each "product" block is one paint for the calculator (same as the home page calculator).
  Logic: assets/hameleon-catalogue.js; colours: assets/hameleon-colors.js.
{%- endcomment -%}
{%- style -%}
  .hm-cat {
    padding: 3.2rem 0 6.4rem;
    background:
      radial-gradient(60rem 40rem at 100% 0%, rgba(0, 170, 193, 0.1), transparent 60%),
      radial-gradient(50rem 40rem at 0% 30%, rgba(25, 165, 74, 0.1), transparent 60%),
      #ffffff;
  }

  .hm-cat__head {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    margin-bottom: 2.4rem;
  }

  .hm-cat__title {
    margin: 0;
    font-family: var(--hm-font-display);
    font-size: clamp(3.2rem, 4.4vw, 5.2rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--hm-text-strong);
  }

  .hm-cat__studio {
    display: grid;
    gap: 2rem;
    align-items: start;
  }

  /* Room */
  .hm-cat__stage {
    position: sticky;
    top: 0;
    z-index: 5;
    margin: 0 calc(var(--page-gutter, 1.5rem) * -1);
    padding: 0.8rem var(--page-gutter, 1.5rem);
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(8px);
  }

  .hm-cat__room {
    position: relative;
    height: 21rem;
    border-radius: 2rem;
    overflow: hidden;
    box-shadow: var(--hm-shadow-lg);
  }

  .hm-cat__room .hm-room {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hm-cat__scenes {
    position: absolute;
    top: 1.2rem;
    right: 1.2rem;
    display: flex;
    gap: 0.4rem;
    padding: 0.4rem;
    border-radius: var(--hm-radius-pill);
    background: rgba(255, 255, 255, 0.9);
    box-shadow: var(--hm-shadow-sm);
  }

  .hm-cat__scene {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 1.1rem;
    border: 0;
    border-radius: var(--hm-radius-pill);
    background: none;
    font-family: var(--hm-font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--hm-text-muted);
    cursor: pointer;
  }

  .hm-cat__scene svg {
    width: 1.6rem;
    height: 1.6rem;
  }

  .hm-cat__scene[aria-pressed='true'] {
    background: var(--hm-text-strong);
    color: #ffffff;
  }

  .hm-cat__now {
    position: absolute;
    left: 1.2rem;
    right: 1.2rem;
    bottom: 1.2rem;
    display: flex;
    align-items: center;
    gap: 1.2rem;
    padding: 0.8rem 0.8rem 0.8rem 0.8rem;
    border-radius: 1.8rem;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(8px);
    box-shadow: var(--hm-shadow-md);
  }

  .hm-cat__now-chip {
    flex: 0 0 4.8rem;
    width: 4.8rem;
    height: 4.8rem;
    border-radius: 1.2rem;
    background: var(--wall, #e8e2d6);
    background-size: cover;
    background-position: center;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.08);
    transition: background-color 0.5s;
  }

  .hm-cat__now-text {
    display: flex;
    flex: 1;
    min-width: 0;
    flex-direction: column;
  }

  .hm-cat__now-code {
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--hm-text-muted);
  }

  .hm-cat__now-name {
    overflow: hidden;
    font-family: var(--hm-font-display);
    font-size: 1.7rem;
    font-weight: 800;
    color: var(--hm-text-strong);
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .hm-cat__now .hm-btn {
    flex: 0 0 auto;
    min-height: 4.4rem;
    padding: 0 1.6rem;
    font-size: 1.4rem;
  }

  .hm-cat__go-short {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .hm-cat__go-long {
      display: none;
    }

    .hm-cat__go-short {
      display: inline;
    }

    .hm-cat__now {
      left: 0.8rem;
      right: 0.8rem;
      bottom: 0.8rem;
      gap: 0.8rem;
      padding: 0.6rem;
      border-radius: 1.4rem;
    }

    .hm-cat__now-chip {
      flex-basis: 3.6rem;
      width: 3.6rem;
      height: 3.6rem;
    }

    .hm-cat__now-name {
      font-size: 1.5rem;
    }

    .hm-cat__now .hm-btn {
      min-height: 4rem;
      padding: 0 1.2rem;
    }

    .hm-cat__scenes {
      top: 0.8rem;
      right: 0.8rem;
    }
  }

  .hm-cat__recent {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1rem;
    min-height: 3.2rem;
    font-size: 1.25rem;
    color: var(--hm-text-muted);
  }

  .hm-cat__recent[hidden] {
    display: none;
  }

  .hm-cat__recent button {
    width: 3.2rem;
    height: 3.2rem;
    padding: 0;
    border: 0;
    border-radius: 0.9rem;
    background-size: cover;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.1);
    cursor: pointer;
    transition: transform 0.2s var(--hm-ease);
  }

  .hm-cat__recent button:hover {
    transform: scale(1.1);
  }

  /* Browser */
  .hm-cat__browser {
    min-width: 0;
  }

  .hm-cat__tabs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.4rem;
    padding: 0.4rem;
    border-radius: 1.6rem;
    background: var(--hm-surface-sunken);
  }

  .hm-cat__tab {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 1rem;
    border: 0;
    border-radius: 1.2rem;
    background: none;
    font-family: var(--hm-font-display);
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--hm-text-muted);
    cursor: pointer;
  }

  .hm-cat__tab small {
    font-family: var(--hm-font-body);
    font-size: 1.2rem;
    font-weight: 600;
  }

  .hm-cat__tab[aria-selected='true'] {
    background: #ffffff;
    color: var(--hm-text-strong);
    box-shadow: var(--hm-shadow-sm);
  }

  .hm-cat__tools {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    margin: 1.6rem 0;
  }

  .hm-cat__search {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    height: 5.2rem;
    padding: 0 1.6rem;
    border: 1px solid var(--hm-border-strong);
    border-radius: 1.4rem;
    background: #ffffff;
    color: var(--hm-text-muted);
  }

  .hm-cat__search:focus-within {
    border-color: var(--hm-primary);
    box-shadow: 0 0 0 3px rgba(18, 128, 58, 0.16);
  }

  .hm-cat__search svg {
    flex: 0 0 2rem;
    width: 2rem;
    height: 2rem;
  }

  .hm-cat__search input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: none;
    background: none;
    font-size: 1.6rem;
    color: var(--hm-text-strong);
  }

  .hm-cat__families {
    display: flex;
    gap: 0.6rem;
    margin: 0;
    padding: 0 0 0.2rem;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .hm-cat__families[hidden] {
    display: none;
  }

  .hm-cat__more {
    grid-column: 1 / -1;
    justify-self: center;
    margin-top: 0.8rem;
  }

  .hm-cat__families::-webkit-scrollbar {
    display: none;
  }

  .hm-cat__family {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 1.2rem 0.5rem 0.5rem;
    border: 1px solid var(--hm-border);
    border-radius: var(--hm-radius-pill);
    background: #ffffff;
    font-family: var(--hm-font-display);
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--hm-text-strong);
    white-space: nowrap;
    cursor: pointer;
  }

  .hm-cat__family i {
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.08);
  }

  .hm-cat__family small {
    font-size: 1.1rem;
    color: var(--hm-text-muted);
  }

  .hm-cat__family[aria-pressed='true'] {
    border-color: var(--hm-text-strong);
    background: var(--hm-text-strong);
    color: #ffffff;
  }

  .hm-cat__family[aria-pressed='true'] small {
    color: #c9cfcc;
  }

  .hm-cat__count {
    margin: 0 0 1rem;
    font-size: 1.3rem;
    color: var(--hm-text-muted);
  }

  .hm-cat__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(8.4rem, 1fr));
    gap: 1rem;
  }

  .hm-chip {
    display: flex;
    flex-direction: column;
    padding: 0;
    border: 0;
    border-radius: 1.2rem;
    background: #ffffff;
    box-shadow: var(--hm-shadow-sm);
    overflow: hidden;
    text-align: left;
    cursor: pointer;
    transition: transform 0.2s var(--hm-ease), box-shadow 0.2s;
  }

  .hm-chip:hover {
    transform: translateY(-3px);
    box-shadow: var(--hm-shadow-md);
  }

  .hm-chip[aria-pressed='true'] {
    box-shadow: 0 0 0 2px #ffffff, 0 0 0 4px var(--hm-text-strong), var(--hm-shadow-md);
  }

  .hm-chip__color {
    display: block;
    aspect-ratio: 1 / 0.85;
    background-size: cover;
    background-position: center;
  }

  .hm-chip__meta {
    display: flex;
    flex-direction: column;
    padding: 0.6rem 0.8rem 0.8rem;
  }

  .hm-chip__code {
    font-family: var(--hm-font-display);
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--hm-text-strong);
  }

  .hm-chip__name {
    overflow: hidden;
    font-size: 1.15rem;
    line-height: 1.3;
    color: var(--hm-text-muted);
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .hm-cat__empty {
    grid-column: 1 / -1;
    margin: 0;
    padding: 3.2rem 1.6rem;
    border-radius: 1.6rem;
    background: var(--hm-surface-sunken);
    text-align: center;
    color: var(--hm-text-muted);
  }

  /* Calculator and cart summary */
  .hm-cat__calc {
    margin-top: 6.4rem;
    scroll-margin-top: 2rem;
  }

  .hm-cat__calc-head {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    margin-bottom: 2.4rem;
  }

  .hm-cat__order {
    margin-top: 2.4rem;
    padding: 2.4rem;
    border: 1px solid var(--hm-border);
    border-radius: 2.4rem;
    background: #ffffff;
    box-shadow: var(--hm-shadow-md);
  }

  .hm-cat__order[hidden] {
    display: none;
  }

  .hm-cat__order h3 {
    margin: 0 0 1.4rem;
    font-family: var(--hm-font-display);
    font-size: 2rem;
    font-weight: 800;
    color: var(--hm-text-strong);
  }

  .hm-cat__lines {
    display: grid;
    gap: 0.8rem;
    margin: 0 0 1.6rem;
    padding: 0;
    list-style: none;
  }

  .hm-cat__line {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    padding: 1rem 1.2rem;
    border-radius: 1.4rem;
    background: var(--hm-surface-sunken);
  }

  .hm-cat__line i {
    flex: 0 0 3.6rem;
    width: 3.6rem;
    height: 3.6rem;
    border-radius: 1rem;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.08);
  }

  .hm-cat__line span {
    flex: 1;
    min-width: 0;
    font-size: 1.4rem;
  }

  .hm-cat__line strong {
    font-family: var(--hm-font-display);
  }

  .hm-cat__order-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.2rem;
  }

  .hm-cat__order-foot p {
    margin: 0;
    font-size: 1.5rem;
  }

  @media screen and (min-width: 750px) {
    .hm-cat__room {
      height: 34rem;
    }

    .hm-cat__tools {
      flex-direction: row;
      align-items: center;
    }

    .hm-cat__search {
      flex: 0 0 26rem;
    }
  }

  @media screen and (min-width: 990px) {
    .hm-cat {
      padding: 5.6rem 0 10.4rem;
    }

    .hm-cat__studio {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      gap: 4rem;
    }

    .hm-cat__stage {
      top: 2rem;
      margin: 0;
      padding: 0;
      background: none;
      backdrop-filter: none;
    }

    .hm-cat__room {
      height: auto;
      aspect-ratio: 800 / 560;
    }

    .hm-cat__tools {
      flex-direction: column;
      align-items: stretch;
    }

    .hm-cat__search {
      flex: 0 0 auto;
    }

    .hm-cat__browser .hm-cat__grid {
      max-height: 72rem;
      overflow-y: auto;
      padding: 0.6rem 0.6rem 0.6rem 0.2rem;
      scrollbar-width: thin;
    }
  }
{%- endstyle -%}

<script src="{{ 'hameleon-colors.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'hameleon-catalogue.js' | asset_url }}" defer="defer"></script>

<hameleon-catalogue class="hm-section hm-cat" style="display: block;" data-motivo-base="{{ 'hm-motivo-01.jpg' | asset_url }}">
  <div class="page-width">
    <div class="hm-cat__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="hm-eyebrow" data-reveal>{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="hm-cat__title" data-reveal style="--d: 1">{{ section.settings.heading | escape }}</h1>
      {%- if section.settings.text != blank -%}
        <p class="hm-sub" data-reveal style="--d: 2">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>

    <div class="hm-cat__studio">
      <div class="hm-cat__stage">
        <div class="hm-cat__room" data-cat-room>
          <div data-scene="living">{%- render 'hameleon-room', id: 'hm-cat-living' -%}</div>
          <div data-scene="bedroom" hidden>{%- render 'hameleon-room', id: 'hm-cat-bedroom', scene: 'bedroom' -%}</div>
          <div class="hm-cat__scenes" role="group" aria-label="Стая">
            <button type="button" class="hm-cat__scene" aria-pressed="true" data-scene-btn="living">{%- render 'hameleon-icon', icon: 'sofa' -%}Хол</button>
            <button type="button" class="hm-cat__scene" aria-pressed="false" data-scene-btn="bedroom">{%- render 'hameleon-icon', icon: 'bed' -%}Спалня</button>
          </div>
          <div class="hm-cat__now" aria-live="polite">
            <span class="hm-cat__now-chip" data-now-chip></span>
            <span class="hm-cat__now-text">
              <span class="hm-cat__now-code" data-now-code>Изберете цвят</span>
              <span class="hm-cat__now-name" data-now-name>—</span>
            </span>
            <a class="hm-btn hm-btn--primary" href="#kalkulator" data-now-go><span class="hm-cat__go-long">Колко ми трябва?</span><span class="hm-cat__go-short">Сметка</span> <span class="hm-btn__arrow" aria-hidden="true">↓</span></a>
          </div>
        </div>
        <div class="hm-cat__recent" data-recent hidden>Последно: </div>
      </div>

      <div class="hm-cat__browser" id="katalog">
        <div class="hm-cat__tabs" role="tablist">
          <button type="button" class="hm-cat__tab" role="tab" aria-selected="true" data-tab="vitex">Бои Vitex<small>1320 цвята</small></button>
          <button type="button" class="hm-cat__tab" role="tab" aria-selected="false" data-tab="motivo">Мазилки Motivo<small>78 цвята</small></button>
        </div>
        <div class="hm-cat__tools">
          <label class="hm-cat__search">
            {%- render 'hameleon-icon', icon: 'search' -%}
            <input type="search" inputmode="search" placeholder="Код или име, напр. 675" aria-label="Търсене по код или име" data-search>
          </label>
          <ul class="hm-cat__families" data-families aria-label="Цветови групи"></ul>
        </div>
        <p class="hm-cat__count" data-count></p>
        <div class="hm-cat__grid" data-grid></div>
      </div>
    </div>

    <div class="hm-cat__calc" id="kalkulator">
      <div class="hm-cat__calc-head">
        <p class="hm-eyebrow">{{ section.settings.calc_eyebrow | escape }}</p>
        <h2 class="hm-h2">{{ section.settings.calc_heading | escape }}</h2>
        {%- if section.settings.calc_text != blank -%}
          <p class="hm-sub">{{ section.settings.calc_text | escape }}</p>
        {%- endif -%}
      </div>
      {%- render 'hameleon-paint-calc', section: section, in_catalogue: true -%}

      <div class="hm-cat__order" data-order hidden>
        <h3>Боя в количката</h3>
        <ul class="hm-cat__lines" data-order-lines></ul>
        <div class="hm-cat__order-foot">
          <p data-order-total></p>
          <a class="hm-btn hm-btn--primary" href="{{ routes.cart_url }}">Към количката <span class="hm-btn__arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </div>
</hameleon-catalogue>

{% schema %}
{
  "name": "Хамелеон: paint catalogue",
  "tag": "div",
  "class": "section",
  "max_blocks": 40,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Каталог на цветовете" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Вижте цвета на стената, преди да боядисате" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Изберете от 1320 цвята Vitex и 78 мазилки Motivo. Стаята се боядисва веднага. После изчислете колко боя Ви трябва и я поръчайте с кода на цвета." },
    { "type": "text", "id": "calc_eyebrow", "label": "Calculator eyebrow", "default": "Калкулатор и поръчка" },
    { "type": "text", "id": "calc_heading", "label": "Calculator heading", "default": "Колко боя Ви трябва?" },
    { "type": "textarea", "id": "calc_text", "label": "Calculator text", "default": "Изберете боята и площта. Пресмятаме литрите и най-изгодните опаковки, а цветът отива в поръчката с кода си." },
    {
      "type": "select",
      "id": "default_coats",
      "label": "Coats selected at start",
      "default": "2",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" }
      ]
    },
    { "type": "number", "id": "default_area", "label": "Area shown at start (m²)", "default": 40 },
    { "type": "richtext", "id": "warning", "label": "Warning under the result", "default": "<p><strong>Важно!</strong> По технология преди всяка боя трябва да има <strong>грунд</strong> и да се минат <strong>две ръце</strong>.</p>" },
    { "type": "text", "id": "footnote", "label": "Small note at the end", "default": "Цветът на екрана е ориентировъчен. Вижте мострата в магазина, ако се колебаете." }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Paint",
      "settings": [
        {
          "type": "select",
          "id": "category",
          "label": "Category",
          "default": "interior",
          "options": [
            { "value": "interior", "label": "Интериорна боя" },
            { "value": "exterior", "label": "Фасадна боя" },
            { "value": "plaster", "label": "Мазилки" }
          ]
        },
        { "type": "text", "id": "name", "label": "Name", "default": "Vitex Vito" },
        { "type": "text", "id": "class", "label": "Class", "default": "Среден клас" },
        { "type": "text", "id": "note", "label": "Note (e.g. Само бяло)" },
        { "type": "checkbox", "id": "tintable", "label": "Can be tinted", "default": true, "info": "Off for white-only paints: they go to the cart without a colour code." },
        { "type": "image_picker", "id": "image", "label": "Photo of the tin (optional)", "info": "Without a photo or a linked product, the tin is drawn." },
        { "type": "text", "id": "pack_litres", "label": "Coverage: one pack of … litres", "default": "1", "info": "With the next field: one pack of this many litres covers that many m² in one coat." },
        { "type": "text", "id": "pack_sqm", "label": "Coverage: … covers this many m² (one coat)", "default": "11" },
        { "type": "text", "id": "sizes", "label": "Pack sizes sold, in litres, comma separated", "default": "1, 3, 9, 15", "info": "Use a dot for decimals, e.g. 0.905" },
        { "type": "product", "id": "product", "label": "Shopify product (for price and add to cart)", "info": "Name the variants by pack size, e.g. \"1 л\", \"3 л\", \"9 л\". Each size the calculator picks must have a variant." },
        { "type": "url", "id": "link", "label": "Or a link (optional)" }
      ]
    }
  ],
