{%- comment -%}
  Хамелеон: "Инструменти за ремонта". Heading, quick links to tool categories (chip blocks),
  products from a collection, the brands line and a button to all tools.
{%- endcomment -%}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{%- style -%}
  .hm-tools-{{ section.id }} {
    padding: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px 0 {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .hm-tools-{{ section.id }} {
      padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}
{%- style -%}
  .hm-tools__inner {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .hm-tools__head {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .hm-tools__title {
    font-size: 2.4rem;
  }

  .hm-tools__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hm-chip {
    display: inline-flex;
    align-items: center;
    min-height: 4rem;
    padding: 0 1.6rem;
    border: 1px solid var(--hm-border);
    border-radius: var(--hm-radius-pill);
    box-sizing: border-box;
    background: var(--hm-surface);
    color: var(--hm-text-strong);
    font-size: 1.5rem;
    font-weight: 600;
    text-decoration: none;
  }

  .hm-chip:hover {
    border-color: var(--hm-primary);
  }

  .hm-tools .product-grid {
    margin: 0;
  }

  .hm-tools__brands {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8rem 2.4rem;
    margin: 0;
  }

  .hm-tools__brands-label {
    font-size: 1.4rem;
    font-weight: 600;
  }

  .hm-tools__brand {
    font-family: var(--hm-font-display);
    font-size: 1.8rem;
    font-weight: 800;
    color: var(--hm-text-muted);
    text-decoration: none;
  }

  .hm-tools__brand img {
    display: block;
    height: 3.2rem;
    width: auto;
  }

  .hm-tools__footer .hm-btn {
    width: 100%;
  }

  @media screen and (min-width: 750px) {
    .hm-tools__head {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: 2.4rem;
    }

    .hm-tools__head-text {
      display: flex;
      flex-direction: column;
      gap: 0.8rem;
    }

    .hm-tools__footer {
      display: none;
    }
  }

  @media screen and (max-width: 749px) {
    .hm-tools__head > .hm-btn {
      display: none;
    }
  }
{%- endstyle -%}

{%- liquid
  assign chips = section.blocks | where: 'type', 'chip'
  assign brands = section.blocks | where: 'type', 'brand'
  assign collection = section.settings.collection
-%}

<section class="hm-section hm-tools hm-tools-{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width hm-tools__inner">
    <div class="hm-tools__head">
      <div class="hm-tools__head-text">
        {%- if section.settings.eyebrow != blank -%}
          <p class="hm-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="hm-heading hm-tools__title">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}
          <p style="margin: 0;">{{ section.settings.text | escape }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.button_label != blank -%}
        <a class="hm-btn hm-btn--secondary" href="{{ section.settings.button_link | default: collection.url | default: routes.all_products_collection_url }}">
          {{- section.settings.button_label | escape -}}
        </a>
      {%- endif -%}
    </div>

    {%- if chips.size > 0 -%}
      <ul class="hm-tools__chips" aria-label="{{ section.settings.heading | escape }}">
        {%- for block in chips -%}
          <li {{ block.shopify_attributes }}>
            <a class="hm-chip" href="{% if block.settings.link != blank %}{{ block.settings.link }}{% else %}{{ routes.search_url }}?type=product&amp;q={{ block.settings.title | url_encode }}{% endif %}">{{ block.settings.title | escape }}</a>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.products_to_show > 0 -%}
      <ul class="grid product-grid grid--2-col-tablet-down grid--4-col-desktop" role="list">
        {%- if collection != blank and collection.products_count > 0 -%}
          {%- for product in collection.products limit: section.settings.products_to_show -%}
            <li class="grid__item">
              {% render 'card-product',
                card_product: product,
                media_aspect_ratio: 'square',
                show_vendor: true,
                lazy_load: true,
                skip_styles: true,
                section_id: section.id,
                quick_add: 'none'
              %}
            </li>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..section.settings.products_to_show) -%}
            <li class="grid__item">
              {% render 'card-product', show_vendor: true, media_aspect_ratio: 'square', lazy_load: false, skip_styles: true, placeholder_image: 'product-apparel-1' %}
            </li>
          {%- endfor -%}
        {%- endif -%}
      </ul>
    {%- endif -%}

    {%- if brands.size > 0 -%}
      <div class="hm-tools__brands">
        <span class="hm-tools__brands-label">{{ section.settings.brands_label | escape }}</span>
        {%- for block in brands -%}
          <a class="hm-tools__brand" href="{% if block.settings.link != blank %}{{ block.settings.link }}{% else %}{{ routes.search_url }}?type=product&amp;q={{ block.settings.name | url_encode }}{% endif %}" {{ block.shopify_attributes }}>
            {%- if block.settings.logo != blank -%}
              {{ block.settings.logo | image_url: height: 64 | image_tag: alt: block.settings.name, loading: 'lazy' }}
            {%- else -%}
              {{ block.settings.name | escape }}
            {%- endif -%}
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="hm-tools__footer">
        <a class="hm-btn hm-btn--secondary" href="{{ section.settings.button_link | default: collection.url | default: routes.all_products_collection_url }}">
          {{- section.settings.button_label | escape -}}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Хамелеон: tools",
  "tag": "div",
  "class": "section",
  "max_blocks": 16,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Железария" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Инструменти за ремонта" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Електро и ръчни инструменти, градина, крепежи и консумативи. Всичко за ремонта на едно място." },
    { "type": "collection", "id": "collection", "label": "Products from collection" },
    { "type": "range", "id": "products_to_show", "min": 0, "max": 8, "step": 1, "label": "Number of products", "default": 4 },
    { "type": "text", "id": "brands_label", "label": "Brands label", "default": "Марки:" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Всички инструменти" },
    { "type": "url", "id": "button_link", "label": "Button link (defaults to the collection)" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 48 }
  ],
  "blocks": [
    {
      "type": "chip",
      "name": "Category link",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Бормашини" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    },
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "TOTAL" },
        { "type": "image_picker", "id": "logo", "label": "Logo (optional, shown instead of the name)" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Хамелеон: tools",
      "blocks": [
        { "type": "chip", "settings": { "title": "Бормашини" } },
        { "type": "chip", "settings": { "title": "Винтоверти" } },
        { "type": "chip", "settings": { "title": "Ъглошлайфи" } },
        { "type": "chip", "settings": { "title": "Перфоратори" } },
        { "type": "chip", "settings": { "title": "Циркуляри" } },
        { "type": "chip", "settings": { "title": "Батерии и зарядни" } },
        { "type": "chip", "settings": { "title": "Комплекти машини" } },
        { "type": "chip", "settings": { "title": "Ръчни инструменти" } },
        { "type": "brand", "settings": { "name": "TOTAL" } },
        { "type": "brand", "settings": { "name": "RAIDER" } },
        { "type": "brand", "settings": { "name": "DeWALT" } }
      ]
    }
  ]
}
{% endschema %}
