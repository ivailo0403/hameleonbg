{%- comment -%}
  Хамелеон: store card on the home page (photo, address, hours, phone, link to the store page).
  Address, phone and hours come from Theme settings → Хамелеон: магазин.
{%- endcomment -%}
{%- style -%}
  .hm-store-card-{{ section.id }} {
    padding: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px 0 {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .hm-store-card-{{ section.id }} {
      padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}
{%- style -%}
  .hm-store-card__box {
    display: grid;
    border: 1px solid var(--hm-border);
    border-radius: 2.4rem;
    overflow: hidden;
    background: #ffffff;
    box-shadow: var(--hm-shadow-md);
  }

  .hm-store-card__media {
    min-height: 20rem;
    background: var(--hm-surface-sunken);
  }

  .hm-store-card__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hm-store-card__media .hm-placeholder {
    height: 100%;
    min-height: 20rem;
    border-radius: 0;
  }

  .hm-map {
    position: relative;
    height: 100%;
    min-height: 26rem;
    background:
      linear-gradient(90deg, rgba(26, 28, 30, 0.04) 1px, transparent 1px) 0 0 / 3.2rem 3.2rem,
      linear-gradient(0deg, rgba(26, 28, 30, 0.04) 1px, transparent 1px) 0 0 / 3.2rem 3.2rem,
      #eef2ef;
    overflow: hidden;
  }

  .hm-map--real {
    display: block;
    width: 100%;
    border: 0;
    filter: saturate(0.85);
  }

  .hm-map__road {
    position: absolute;
    background: #ffffff;
    box-shadow: 0 0 0 1px #dde2e0;
  }

  .hm-map__road--a { left: -10%; right: -10%; top: 55%; height: 2.2rem; transform: rotate(-8deg); }
  .hm-map__road--b { top: -10%; bottom: -10%; left: 38%; width: 1.6rem; transform: rotate(12deg); }
  .hm-map__road--c { left: -10%; right: -10%; top: 22%; height: 1.2rem; transform: rotate(4deg); }

  .hm-map__park {
    position: absolute;
    right: 8%;
    bottom: 8%;
    width: 30%;
    height: 24%;
    border-radius: 1.6rem;
    background: #d6ecd9;
  }

  .hm-map__pin {
    position: absolute;
    left: 46%;
    top: 40%;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 5.2rem;
    height: 5.2rem;
    margin: -2.6rem 0 0 -2.6rem;
    border-radius: 50%;
    background: var(--hm-primary);
    color: #ffffff;
    box-shadow: 0 0 0 0 rgba(18, 128, 58, 0.5), var(--hm-shadow-md);
    animation: hm-pulse 2.2s infinite;
  }

  .hm-map__pin svg {
    width: 2.6rem;
    height: 2.6rem;
  }

  .hm-map__label {
    position: absolute;
    left: 46%;
    top: calc(40% + 3.6rem);
    transform: translateX(-50%);
    padding: 0.6rem 1.2rem;
    border-radius: var(--hm-radius-pill);
    background: #ffffff;
    box-shadow: var(--hm-shadow-md);
    font-family: var(--hm-font-display);
    font-size: 1.3rem;
    font-weight: 700;
    white-space: nowrap;
    color: var(--hm-text-strong);
  }

  .hm-store-card__body {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    padding: 2rem 1.6rem;
  }

  .hm-store-card__title {
    font-size: 2.2rem;
  }

  .hm-store-card__buttons {
    display: grid;
    gap: 0.8rem;
  }

  @media screen and (min-width: 1200px) {
    .hm-store-card__buttons {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 750px) {
    .hm-store-card__box {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .hm-store-card__body {
      padding: 3.2rem;
    }
  }
{%- endstyle -%}

<section class="hm-section hm-store-card-{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="hm-store-card__box" data-reveal>
      <div class="hm-store-card__media">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1200
            | image_tag: widths: '400, 600, 800, 1200', sizes: '(min-width: 750px) 50vw, 100vw', loading: 'lazy'
          }}
        {%- elsif section.settings.real_map and settings.hm_store_address != blank -%}
          {%- comment -%} A real Google map of the store address (no API key needed), loaded when it scrolls into view. {%- endcomment -%}
          <iframe
            class="hm-map hm-map--real"
            src="https://maps.google.com/maps?q={{ settings.hm_store_address | url_encode }}&z=16&hl=bg&output=embed"
            title="Карта: {{ settings.hm_store_address | escape }}"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        {%- else -%}
          <div class="hm-map" aria-hidden="true">
            <span class="hm-map__road hm-map__road--a"></span>
            <span class="hm-map__road hm-map__road--b"></span>
            <span class="hm-map__road hm-map__road--c"></span>
            <span class="hm-map__park"></span>
            <span class="hm-map__pin">{%- render 'hameleon-icon', icon: 'pin' -%}</span>
            <span class="hm-map__label">бул. „България“ 21</span>
          </div>
        {%- endif -%}
      </div>
      <div class="hm-store-card__body">
        {%- if section.settings.eyebrow != blank -%}
          <p class="hm-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="hm-h2" style="font-size: clamp(2.6rem, 3.4vw, 3.6rem);">{{ section.settings.heading | default: settings.hm_store_name | escape }}</h2>
        <div class="hm-contact">
          {%- render 'hameleon-icon', icon: 'pin' -%}
          <span>{{ settings.hm_store_address | escape }}</span>
        </div>
        <div class="hm-contact">
          {%- render 'hameleon-icon', icon: 'phone' -%}
          <a href="tel:{{ settings.hm_store_phone_link | escape }}">{{ settings.hm_store_phone | escape }}</a>
        </div>
        {%- render 'hameleon-hours' -%}
        <div class="hm-store-card__buttons">
          {%- assign destination = settings.hm_store_address | url_encode -%}
          {%- assign directions = 'https://www.google.com/maps/dir/?api=1&destination=' | append: destination -%}
          <a class="hm-btn hm-btn--primary" href="{{ settings.hm_store_maps_link | default: directions }}" target="_blank" rel="noopener">Упътване</a>
          <a class="hm-btn hm-btn--secondary" href="{{ section.settings.page_link | default: '#' }}">
            {{- section.settings.page_link_label | escape -}}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Хамелеон: store card",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "paragraph", "content": "Address, phone and hours are set in Theme settings → Хамелеон: магазин." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Магазинът" },
    { "type": "text", "id": "heading", "label": "Heading (defaults to the store name)" },
    { "type": "image_picker", "id": "image", "label": "Store photo" },
    { "type": "checkbox", "id": "real_map", "label": "Show a Google map when there is no photo", "default": true },
    { "type": "text", "id": "page_link_label", "label": "Store page link label", "default": "Как да ни намерите" },
    { "type": "url", "id": "page_link", "label": "Store page link" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 32 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 48 }
  ],
  "presets": [{ "name": "Хамелеон: store card" }]
}
{% endschema %}
